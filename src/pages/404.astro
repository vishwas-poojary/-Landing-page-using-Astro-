---
import HomeLayout from "@/layouts/HomeLayout.astro";
---

<HomeLayout title="404 — Page Not Found" description="The requested page could not be located.">
  <div class="sqsp-container min-h-[60vh] flex flex-col items-center justify-center text-center py-24 space-y-6">
    <span class="text-xs font-mono uppercase tracking-widest text-neutral-500">Error 404</span>
    <h1 class="sqsp-headline-md font-medium text-white">This page could not be found</h1>
    <p class="text-sm text-neutral-400 max-w-md mx-auto">
      The link you clicked may be broken, or the page may have been moved or removed.
    </p>
    <div class="pt-4">
      <a href="/" class="btn-sqsp-primary">
        Return Home →
      </a>
    </div>
  </div>
</HomeLayout>
