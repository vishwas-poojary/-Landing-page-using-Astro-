---
import HomeLayout from "@/layouts/HomeLayout.astro";
import { siteConfig } from "@/lib/site-content";
import Hero from "@/components/home/Hero.astro";
---

<HomeLayout title={siteConfig.title} description={siteConfig.description}>
  <main id="main-content" class="flex-1 overflow-x-hidden">
    <!-- Hero Section (approx 100vh) -->
    <Hero />

    <!-- Section boundary placeholder to enable testing the scroll away animation -->
    <section
      id="explore-section"
      class="min-h-screen bg-[#08080a] flex flex-col items-center justify-center px-6 py-24 text-center border-t border-white/10 relative z-10"
    >
      <div class="max-w-2xl mx-auto space-y-4">
        <span class="inline-block px-3 py-1 text-xs uppercase tracking-widest text-neutral-400 bg-white/5 border border-white/10 rounded-full">
          Scroll Interaction Boundary
        </span>
        <h2 class="text-3xl sm:text-4xl font-medium text-white tracking-tight">
          Next Section Ready For Phase 2
        </h2>
        <p class="text-neutral-400 text-sm sm:text-base max-w-lg mx-auto">
          Scroll back up to test the hero video scale, content fade, upward movement, and transparent navigation transition.
        </p>
      </div>
    </section>
  </main>
</HomeLayout>
