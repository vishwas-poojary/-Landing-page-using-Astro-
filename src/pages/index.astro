---
import HomeLayout from "@/layouts/HomeLayout.astro";
import { siteConfig } from "@/lib/site-content";
import Hero from "@/components/home/Hero.astro";
import ShowcaseSection from "@/components/home/ShowcaseSection.astro";
import FeatureCardsCarousel from "@/components/home/FeatureCardsCarousel.astro";
import TemplatesShowcase from "@/components/home/TemplatesShowcase.astro";
import ConversionCta from "@/components/home/ConversionCta.astro";
---

<HomeLayout title={siteConfig.title} description={siteConfig.description}>
  <main id="main-content" class="flex-1 overflow-x-hidden">
    <!-- Hero Section (Screenshot 1) -->
    <Hero />

    <!-- Showcase Section & Stats Strip (Screenshot 2) -->
    <ShowcaseSection />

    <!-- 4 Feature Cards Carousel (Screenshot 3) -->
    <FeatureCardsCarousel />

    <!-- Award-Winning Templates Showcase -->
    <TemplatesShowcase />

    <!-- Bottom Conversion CTA with Particle Sphere Video (Screenshot 4) -->
    <ConversionCta />
  </main>
</HomeLayout>
