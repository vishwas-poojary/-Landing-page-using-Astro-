---
const features = [
  {
    id: "website-editing",
    title: "Website Editing",
    description: "Easily customize every design detail with our next-generation drag-and-drop editor.",
    bgClass: "bg-[#151619]",
    tag: "Drag & Drop",
  },
  {
    id: "design-intelligence",
    title: "Design Intelligence",
    description: "Your AI creative partner to generate designs, images, and content tailored just for you.",
    bgClass: "bg-[#0f1013]",
    tag: "Creative AI",
  },
  {
    id: "business-email",
    title: "Business Email",
    description: "Make your business official with Business Email from Google Workspace.",
    bgClass: "bg-[#181a1d]",
    tag: "Google Workspace",
  },
  {
    id: "domains",
    title: "Domains",
    description: "Register your dream domain. Free WHOIS privacy, SSL, and premium DNS included.",
    bgClass: "bg-[#141518]",
    tag: "Custom TLDs",
  },
];
---

<section
  id="feature-grid-section"
  class="relative bg-white text-black py-24 sm:py-32 overflow-hidden select-none"
  aria-label="Platform Features Grid"
>
  <div class="sqsp-container max-w-[1560px] mx-auto px-4 sm:px-8">
    <!-- Section Header matching Screenshot 3 & 4 -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 sm:gap-8 mb-12 sm:mb-16">
      <div class="max-w-xl">
        <h2 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-neutral-900 leading-[1.05]">
          Everything you need<br />on one platform
        </h2>
      </div>

      <div class="max-w-md lg:pb-1">
        <p class="text-sm sm:text-base text-neutral-600 font-normal leading-relaxed">
          Power your day to day with all the tools and AI guidance you need to manage your business, seamlessly integrated in one place.
        </p>
      </div>
    </div>

    <!-- 4-Card Grid / Carousel Track matching Screenshot 3 & 4 -->
    <div class="relative">
      <div
        id="feature-cards-viewport"
        class="w-full overflow-x-auto no-scrollbar scroll-smooth"
      >
        <div
          id="feature-cards-track"
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-stretch"
        >
          <!-- Card 1: Website Editing -->
          <div
            class="feature-card group rounded-3xl bg-[#151619] border border-white/10 text-white p-7 sm:p-8 flex flex-col justify-between hover:border-white/25 transition-all duration-300 shadow-xl min-h-[500px]"
          >
            <div>
              <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
                Website Editing
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-2.5 leading-relaxed">
                Easily customize every design detail with our next-generation drag-and-drop editor.
              </p>
            </div>

            <!-- Card 1 Visual Mockup: Ceramics studio editor with grid -->
            <div class="my-6 rounded-2xl bg-neutral-900/90 border border-white/10 p-4 aspect-[4/3] flex flex-col justify-between relative overflow-hidden shadow-inner">
              <!-- Top bar with font swatch -->
              <div class="flex items-center justify-between pb-2 border-b border-white/10 text-xs">
                <span class="text-neutral-500 font-mono text-[10px]">Layout grid</span>
                <div class="flex items-center gap-1.5 bg-white/10 px-2 py-0.5 rounded text-[10px] text-neutral-300">
                  <span class="font-serif">Aa</span>
                  <span class="w-2.5 h-2.5 rounded-full bg-amber-200"></span>
                  <span class="w-2.5 h-2.5 rounded-full bg-stone-600"></span>
                </div>
              </div>

              <!-- Content block preview -->
              <div class="grid grid-cols-2 gap-3 items-center my-auto">
                <div class="rounded-lg overflow-hidden aspect-square bg-neutral-800">
                  <img
                    src="https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&w=400&q=80"
                    alt="Ceramics studio vase"
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <div class="space-y-2">
                  <div class="border border-dashed border-blue-400/80 bg-blue-500/10 p-2 rounded text-[11px] text-white font-medium leading-tight">
                    Ceramics studio based in NYC
                  </div>
                  <span class="inline-block text-[10px] font-semibold text-neutral-300 bg-white/10 px-2.5 py-1 rounded">
                    Button
                  </span>
                </div>
              </div>
            </div>

            <!-- Bottom Action Row with hover-transform arrow -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[11px] font-semibold tracking-wider uppercase text-neutral-400">
                Fluid Engine™
              </span>
              <button
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-white text-white hover:text-black flex items-center justify-center transition-all duration-200 cursor-pointer"
                aria-label="Learn more about Website Editing"
              >
                <span class="text-sm transition-transform duration-200 group-hover:translate-x-1.5">→</span>
              </button>
            </div>
          </div>

          <!-- Card 2: Design Intelligence -->
          <div
            class="feature-card group rounded-3xl bg-[#0f1013] border border-white/10 text-white p-7 sm:p-8 flex flex-col justify-between hover:border-white/25 transition-all duration-300 shadow-xl min-h-[500px]"
          >
            <div>
              <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
                Design Intelligence
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-2.5 leading-relaxed">
                Your AI creative partner to generate designs, images, and content tailored just for you.
              </p>
            </div>

            <!-- Card 2 Visual Mockup: Mesh gradient orb, business cards & font card -->
            <div class="my-6 rounded-2xl bg-neutral-900/90 border border-white/10 p-4 aspect-[4/3] flex flex-col justify-between relative overflow-hidden shadow-inner">
              <div class="grid grid-cols-2 gap-3 items-center my-auto">
                <!-- Glowing gradient sphere -->
                <div class="relative flex items-center justify-center aspect-square">
                  <div class="w-20 h-20 rounded-full bg-gradient-to-tr from-amber-500 via-rose-500 to-indigo-500 blur-[2px] opacity-90 animate-pulse"></div>
                  <!-- Business card mockup -->
                  <div class="absolute -bottom-2 -left-2 bg-stone-100 text-stone-900 text-[10px] font-serif p-2.5 rounded shadow-lg transform -rotate-12 border border-black/10">
                    <span class="block font-bold">Faun</span>
                    <span class="block text-[8px] text-stone-600">STUDIO</span>
                  </div>
                </div>

                <!-- Glass Heading card -->
                <div class="space-y-2">
                  <div class="bg-black/60 backdrop-blur-md border border-white/20 p-2.5 rounded-lg">
                    <span class="text-[9px] text-neutral-400 uppercase font-mono block">FONTS</span>
                    <span class="text-xs font-bold text-white block">Heading</span>
                    <span class="text-[9px] text-neutral-400 block">This is your paragraph font.</span>
                  </div>
                  <div class="flex items-center gap-1.5 bg-black/60 px-2 py-1 rounded text-[10px] border border-white/10">
                    <span class="font-bold">Aa</span>
                    <span class="w-2 h-2 rounded-full bg-stone-200"></span>
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom Action Row -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[11px] font-semibold tracking-wider uppercase text-neutral-400">
                Curated by AI
              </span>
              <button
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-white text-white hover:text-black flex items-center justify-center transition-all duration-200 cursor-pointer"
                aria-label="Learn more about Design Intelligence"
              >
                <span class="text-sm transition-transform duration-200 group-hover:translate-x-1.5">→</span>
              </button>
            </div>
          </div>

          <!-- Card 3: Business Email -->
          <div
            class="feature-card group rounded-3xl bg-[#181a1d] border border-white/10 text-white p-7 sm:p-8 flex flex-col justify-between hover:border-white/25 transition-all duration-300 shadow-xl min-h-[500px]"
          >
            <div>
              <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
                Business Email
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-2.5 leading-relaxed">
                Make your business official with Business Email from Google Workspace.
              </p>
            </div>

            <!-- Card 3 Visual Mockup: Workspace desk with prominent Google Workspace logo -->
            <div class="my-6 rounded-2xl bg-neutral-900/90 border border-white/10 p-4 aspect-[4/3] flex items-center justify-center relative overflow-hidden shadow-inner">
              <img
                src="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=600&q=80"
                alt="Minimalist desk office"
                class="absolute inset-0 w-full h-full object-cover opacity-35"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/40"></div>

              <!-- High fidelity Gmail / Google Workspace Logo Circle -->
              <div class="relative z-10 w-24 h-24 rounded-full bg-white shadow-2xl flex items-center justify-center border-4 border-white/20 transform group-hover:scale-105 transition-transform duration-300">
                <svg class="w-12 h-12" viewBox="0 0 48 48" fill="none">
                  <!-- Official Google Workspace Gmail Icon Colors -->
                  <path d="M4.5 13.5V34.5C4.5 36.9853 6.51472 39 9 39H12V21L24 30L36 21V39H39C41.4853 39 43.5 36.9853 43.5 34.5V13.5L24 28.5L4.5 13.5Z" fill="#EA4335" />
                  <path d="M12 39V21L4.5 13.5V34.5C4.5 36.9853 6.51472 39 9 39H12Z" fill="#4285F4" />
                  <path d="M36 39V21L43.5 13.5V34.5C43.5 36.9853 41.4853 39 39 39H36Z" fill="#34A853" />
                  <path d="M36 9L24 18L12 9H9C6.51472 9 4.5 11.0147 4.5 13.5L24 28.5L43.5 13.5C43.5 11.0147 41.4853 9 39 9H36Z" fill="#FBBC05" />
                </svg>
              </div>
            </div>

            <!-- Bottom Action Row -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[11px] font-semibold tracking-wider uppercase text-neutral-400">
                Custom @yourbrand
              </span>
              <button
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-white text-white hover:text-black flex items-center justify-center transition-all duration-200 cursor-pointer"
                aria-label="Learn more about Business Email"
              >
                <span class="text-sm transition-transform duration-200 group-hover:translate-x-1.5">→</span>
              </button>
            </div>
          </div>

          <!-- Card 4: Domains -->
          <div
            class="feature-card group rounded-3xl bg-[#141518] border border-white/10 text-white p-7 sm:p-8 flex flex-col justify-between hover:border-white/25 transition-all duration-300 shadow-xl min-h-[500px]"
          >
            <div>
              <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
                Domains
              </h3>
              <p class="text-xs sm:text-sm text-neutral-400 mt-2.5 leading-relaxed">
                Register your dream domain. Free WHOIS privacy, SSL, and premium DNS included.
              </p>
            </div>

            <!-- Card 4 Visual Mockup: Floral texture with search bar and TLD chips -->
            <div class="my-6 rounded-2xl bg-neutral-900/90 border border-white/10 p-4 aspect-[4/3] flex items-center justify-center relative overflow-hidden shadow-inner">
              <img
                src="https://images.unsplash.com/photo-1518531933037-91b2f5f229cc?auto=format&fit=crop&w=600&q=80"
                alt="Botanical background"
                class="absolute inset-0 w-full h-full object-cover opacity-25"
                loading="lazy"
              />

              <!-- Interactive Search Mockup Pill -->
              <div class="relative z-10 w-full flex items-center justify-between gap-2">
                <div class="bg-white text-black px-4 py-2.5 rounded-full flex items-center gap-2 flex-1 shadow-2xl">
                  <span class="text-xs text-neutral-400">🔍</span>
                  <span class="text-xs font-semibold font-mono tracking-tight text-neutral-900">helloclay</span>
                  <span class="ml-auto text-xs font-bold text-neutral-600">.com</span>
                </div>

                <!-- Floating TLD stacked pills -->
                <div class="flex flex-col gap-1 text-[9px] font-mono text-neutral-400">
                  <span class="px-2 py-0.5 rounded-full bg-black/60 border border-white/15 text-center">.org</span>
                  <span class="px-2 py-0.5 rounded-full bg-black/60 border border-white/15 text-center">.net</span>
                  <span class="px-2 py-0.5 rounded-full bg-black/60 border border-white/15 text-center">.info</span>
                  <span class="px-2 py-0.5 rounded-full bg-black/60 border border-white/15 text-center">.site</span>
                </div>
              </div>
            </div>

            <!-- Bottom Action Row -->
            <div class="flex items-center justify-between pt-2">
              <span class="text-[11px] font-semibold tracking-wider uppercase text-neutral-400">
                SSL & DNS Included
              </span>
              <button
                class="w-9 h-9 rounded-full bg-white/10 hover:bg-white text-white hover:text-black flex items-center justify-center transition-all duration-200 cursor-pointer"
                aria-label="Learn more about Domains"
              >
                <span class="text-sm transition-transform duration-200 group-hover:translate-x-1.5">→</span>
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- Carousel dots & navigation buttons on mobile/tablet matching Screenshot 4 -->
      <div class="flex items-center justify-between max-w-xs mx-auto mt-8 sm:mt-10 px-4 lg:hidden">
        <button
          id="feat-prev-btn"
          class="w-9 h-9 rounded-full border border-neutral-300 hover:border-black flex items-center justify-center text-neutral-700 hover:text-black transition-colors"
          aria-label="Previous Feature Card"
        >
          ←
        </button>
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-neutral-900"></span>
          <span class="w-2 h-2 rounded-full bg-neutral-300"></span>
          <span class="w-2 h-2 rounded-full bg-neutral-300"></span>
          <span class="w-2 h-2 rounded-full bg-neutral-300"></span>
        </div>
        <button
          id="feat-next-btn"
          class="w-9 h-9 rounded-full border border-neutral-300 hover:border-black flex items-center justify-center text-neutral-700 hover:text-black transition-colors"
          aria-label="Next Feature Card"
        >
          →
        </button>
      </div>
    </div>
  </div>
</section>
