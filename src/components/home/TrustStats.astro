---
import { trustStatsData } from "@/lib/site-content";
---

<section class="py-20 lg:py-28 bg-neutral-950 border-b border-white/10 relative">
  <div class="sqsp-container">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <h2 class="sqsp-headline-md font-medium text-white">
        {trustStatsData.headline}
      </h2>
    </div>

    <!-- 4 Stats Cards -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 mb-20 reveal-on-scroll">
      {trustStatsData.stats.map((stat) => (
        <div class="bg-black/60 border border-white/10 rounded-3xl p-6 sm:p-8 text-center space-y-2 hover:border-white/20 transition-all">
          <div class="text-4xl sm:text-5xl lg:text-6xl font-light text-white font-mono tracking-tight">
            {stat.value}
          </div>
          <p class="text-xs sm:text-sm text-neutral-400 font-medium">
            {stat.label}
          </p>
        </div>
      ))}
    </div>

    <!-- Brand Logos Grid -->
    <div class="pt-8 border-t border-white/10">
      <p class="text-center text-xs uppercase tracking-widest text-neutral-500 mb-8 font-semibold">
        Empowering leading independent businesses
      </p>

      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-14 lg:gap-20 text-neutral-400">
        {trustStatsData.logos.map((logo) => (
          <div class="text-lg sm:text-xl font-bold tracking-[0.25em] uppercase hover:text-white transition-colors cursor-default select-none">
            {logo.label}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
