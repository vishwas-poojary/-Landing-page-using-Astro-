---
import { onePlatformData } from "@/lib/site-content";
---

<section id="one-platform" class="py-20 lg:py-32 bg-neutral-950 border-b border-white/10 relative overflow-hidden">
  <div class="sqsp-container">
    <!-- Header with Scroll Reveal -->
    <div class="max-w-3xl mb-16 lg:mb-24 reveal-on-scroll">
      <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3 block">
        {onePlatformData.tag}
      </span>
      <h2 class="sqsp-headline-lg font-medium text-white mb-4">
        {onePlatformData.title}
      </h2>
      <p class="sqsp-body-lg text-neutral-400">
        {onePlatformData.subtitle}
      </p>
    </div>

    <!-- 3 Pillars Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {onePlatformData.pillars.map((pillar) => (
        <div class="group bg-black/60 border border-white/10 hover:border-white/25 rounded-3xl p-6 sm:p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 reveal-on-scroll">
          <div>
            <!-- Header Row -->
            <div class="flex items-center justify-between mb-6 pb-4 border-b border-white/10">
              <span class="text-3xl font-light text-neutral-500 font-mono">
                {pillar.number}
              </span>
              <span class="text-xs font-semibold uppercase tracking-wider text-neutral-400 bg-white/5 border border-white/10 px-3 py-1 rounded-full">
                {pillar.badge}
              </span>
            </div>

            <!-- Title & Description -->
            <h3 class="text-2xl font-medium text-white mb-3">
              {pillar.title}
            </h3>
            <p class="text-sm text-neutral-400 leading-relaxed mb-6">
              {pillar.description}
            </p>

            <!-- Video or Visual Media Showcase -->
            <div class="rounded-2xl overflow-hidden aspect-[16/10] bg-neutral-900 border border-white/10 relative mb-6">
              <video
                class="w-full h-full object-cover scale-[1.01]"
                autoplay
                loop
                muted
                playsinline
                preload="metadata"
                poster={pillar.poster}
              >
                <source src={pillar.video} type="video/mp4" />
              </video>
            </div>
          </div>

          <!-- Feature Bullets -->
          <ul class="space-y-2.5 pt-4 border-t border-white/10">
            {pillar.features.map((feat) => (
              <li class="flex items-center gap-2.5 text-xs text-neutral-300 font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-white/60"></span>
                <span>{feat}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
