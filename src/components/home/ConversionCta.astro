---
---

<section id="conversion" class="py-24 lg:py-36 bg-black relative overflow-hidden">
  <!-- Glowing subtle gradient halo -->
  <div class="absolute inset-0 bg-radial-[circle_at_center] from-white/[0.05] via-transparent to-transparent pointer-events-none"></div>

  <div class="sqsp-container max-w-4xl text-center relative z-10 space-y-8 reveal-on-scroll" data-motion="fade-up">
    <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold uppercase tracking-widest bg-white/10 text-white border border-white/10">
      Ready to build?
    </span>

    <h2 class="sqsp-headline-lg font-medium text-white max-w-3xl mx-auto leading-tight">
      Start your free website trial today
    </h2>

    <p class="sqsp-body-lg text-neutral-300 max-w-xl mx-auto">
      Turn any vision into reality. No credit card required, unlimited customization, and award-winning templates ready for your business.
    </p>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#templates" class="btn-sqsp-primary text-xs !py-3.5 !px-8 uppercase tracking-widest shadow-2xl group w-full sm:w-auto">
        <span>GET STARTED</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
      </a>
      <a href="#templates" class="btn-sqsp-secondary text-xs !py-3.5 !px-8 uppercase tracking-widest w-full sm:w-auto">
        BROWSE TEMPLATES
      </a>
    </div>

    <!-- Assurance indicators -->
    <div class="pt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs text-neutral-400">
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Free 14-day trial</span>
      </span>
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>No credit card required</span>
      </span>
      <span class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        <span>Cancel anytime</span>
      </span>
    </div>
  </div>
</section>

