---
const conversionVideo = {
  mp4: "https://media-www.sqspcdn.com/images/components/conversion/conversion-centered.mp4",
  poster: "https://media-www.sqspcdn.com/images/components/conversion/conversion-centered-poster-1500w.webp",
};
---

<section id="conversion" class="relative min-h-[90vh] py-32 flex items-center justify-center bg-black text-white overflow-hidden select-none">
  <!-- Glowing Particle Sphere Video Background (Matching Screenshot 4) -->
  <div class="absolute inset-0 w-full h-full z-0 flex items-center justify-center overflow-hidden">
    <video
      class="w-full h-full max-w-[1200px] max-h-[1200px] object-contain opacity-75 transform scale-110 pointer-events-none"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={conversionVideo.poster}
    >
      <source src={conversionVideo.mp4} type="video/mp4" />
    </video>

    <!-- Ambient Darkening Radial Gradient -->
    <div class="absolute inset-0 bg-radial-[circle_at_center] from-transparent via-black/40 to-black pointer-events-none"></div>
  </div>

  <!-- Content Overlay (Matching Screenshot 4) -->
  <div class="sqsp-container max-w-4xl text-center relative z-10 space-y-6">
    <h2 class="text-4xl sm:text-6xl md:text-7xl lg:text-[80px] font-sans font-medium tracking-tight text-white leading-[1.05] drop-shadow-lg">
      Start your free website trial<br />today
    </h2>

    <p class="text-neutral-400 text-sm sm:text-base font-normal tracking-wide drop-shadow">
      No credit card required. Cancel anytime.
    </p>

    <div class="pt-6 flex justify-center">
      <a
        href="#templates"
        class="inline-flex items-center justify-center bg-white text-black hover:bg-neutral-100 font-bold uppercase tracking-[0.08em] text-xs sm:text-sm px-10 sm:px-14 py-4 rounded-[4px] shadow-2xl transition-all duration-200 hover:scale-[1.02] cursor-pointer"
      >
        GET STARTED
      </a>
    </div>
  </div>
</section>
