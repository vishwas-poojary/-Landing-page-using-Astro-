---
import { domainSectionData } from "@/lib/site-content";
---

<section id="domains" class="py-20 lg:py-32 bg-black border-b border-white/10 relative">
  <div class="sqsp-container max-w-4xl text-center reveal-on-scroll">
    <h2 class="sqsp-headline-lg font-medium text-white mb-4">
      {domainSectionData.title}
    </h2>
    <p class="sqsp-body-lg text-neutral-400 max-w-2xl mx-auto mb-10">
      {domainSectionData.subtitle}
    </p>

    <!-- Interactive Domain Search Input Form -->
    <div class="relative max-w-2xl mx-auto">
      <form id="domain-search-form" class="flex flex-col sm:flex-row items-center gap-3 bg-neutral-950 p-2 sm:p-2.5 rounded-2xl sm:rounded-full border border-white/20 shadow-2xl focus-within:border-white transition-all">
        <div class="flex items-center gap-3 flex-1 pl-4 w-full">
          <svg class="w-5 h-5 text-neutral-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            id="domain-input"
            type="text"
            placeholder="Search your brand name or domain..."
            class="w-full bg-transparent text-white placeholder-neutral-500 text-sm focus:outline-none py-2"
          />
        </div>
        <button
          type="submit"
          class="btn-sqsp-primary w-full sm:w-auto text-xs !py-3 !px-7 shrink-0 cursor-pointer"
        >
          Search Domains →
        </button>
      </form>

      <!-- Instant Results Box (Simulator) -->
      <div id="domain-results" class="hidden mt-6 text-left bg-neutral-950 border border-white/10 rounded-2xl p-6 space-y-4 animate-fade-in shadow-2xl">
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">Suggested Addresses</span>
          <span class="text-xs text-emerald-400 font-medium">✓ Available to register</span>
        </div>

        <div id="domain-results-list" class="space-y-3">
          <!-- Dynamic Results populated via JS -->
        </div>
      </div>
    </div>

    <!-- Popular TLD Pricing Chips -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {domainSectionData.popularTlds.map((item) => (
        <div class="px-4 py-2 rounded-full bg-neutral-950 border border-white/10 text-xs flex items-center gap-2">
          <span class="font-bold text-white font-mono">{item.tld}</span>
          <span class="text-neutral-400">{item.price}</span>
          {item.badge && (
            <span class="px-1.5 py-0.5 rounded text-[9px] font-semibold bg-white/10 text-neutral-200">
              {item.badge}
            </span>
          )}
        </div>
      ))}
    </div>

    <!-- Domain Perks -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-8 text-xs text-neutral-400">
      {domainSectionData.features.map((feat) => (
        <span class="flex items-center gap-2">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          <span>{feat}</span>
        </span>
      ))}
    </div>
  </div>
</section>

<script>
  function setupDomainSearch() {
    const form = document.getElementById("domain-search-form");
    const input = document.getElementById("domain-input") as HTMLInputElement | null;
    const resultsBox = document.getElementById("domain-results");
    const list = document.getElementById("domain-results-list");

    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const query = input?.value.trim().toLowerCase().replace(/[^a-z0-9]/g, "") || "mybrand";

      const extensions = [
        { ext: ".com", price: "$20/yr", status: "Available" },
        { ext: ".design", price: "$35/yr", status: "Available" },
        { ext: ".studio", price: "$25/yr", status: "Available" },
        { ext: ".store", price: "$18/yr", status: "Available" },
      ];

      if (list) {
        list.innerHTML = extensions
          .map(
            (item) => `
          <div class="flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 hover:border-white/20 transition-all">
            <div class="flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span class="font-medium text-sm text-white font-mono">${query}${item.ext}</span>
            </div>
            <div class="flex items-center gap-4">
              <span class="text-xs text-neutral-400 font-mono">${item.price}</span>
              <a href="#templates" class="text-xs bg-white text-black font-semibold px-3 py-1.5 rounded-full hover:bg-neutral-200 transition-colors">
                Select →
              </a>
            </div>
          </div>
        `
          )
          .join("");
      }

      resultsBox?.classList.remove("hidden");
    });
  }

  setupDomainSearch();
  document.addEventListener("astro:page-load", setupDomainSearch);
</script>
