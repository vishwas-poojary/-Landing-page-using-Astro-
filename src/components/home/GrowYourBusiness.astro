---
import { growBusinessData } from "@/lib/site-content";
---

<section id="grow-your-business" class="py-20 lg:py-32 bg-black relative border-b border-white/10">
  <div class="sqsp-container">
    <!-- Section Header with Scroll Reveal -->
    <div class="max-w-3xl mb-12 lg:mb-16 reveal-on-scroll">
      <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3 block">
        {growBusinessData.tag}
      </span>
      <h2 class="sqsp-headline-lg font-medium text-white mb-4">
        {growBusinessData.title}
      </h2>
      <p class="sqsp-body-lg text-neutral-400">
        {growBusinessData.subtitle}
      </p>
    </div>

    <!-- Interactive Tabs Navigation -->
    <div class="flex items-center gap-2 overflow-x-auto pb-4 scrollbar-none no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
      {growBusinessData.tabs.map((tab, idx) => (
        <button
          type="button"
          data-tab-target={tab.id}
          class={`tab-trigger shrink-0 px-5 py-2.5 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer ${
            idx === 0
              ? "bg-white text-black shadow-lg"
              : "bg-white/5 text-neutral-400 hover:text-white hover:bg-white/10 border border-white/5"
          }`}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab Panels Container -->
    <div class="mt-8 lg:mt-12">
      {growBusinessData.tabs.map((tab, idx) => (
        <div
          id={`tab-panel-${tab.id}`}
          class={`tab-panel transition-all duration-300 ${idx === 0 ? "block opacity-100" : "hidden opacity-0"}`}
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center bg-neutral-950/80 border border-white/10 rounded-3xl p-6 sm:p-10 lg:p-14 relative overflow-hidden">
            <!-- Left Content Column -->
            <div class="lg:col-span-5 space-y-6">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-white/10 text-white border border-white/10">
                {tab.badge}
              </span>

              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-medium text-white leading-tight">
                {tab.headline}
              </h3>

              <p class="text-base text-neutral-400 leading-relaxed">
                {tab.description}
              </p>

              <!-- Feature Highlights -->
              <ul class="space-y-3 pt-2">
                {tab.highlights.map((highlight) => (
                  <li class="flex items-center gap-3 text-sm text-neutral-300 font-medium">
                    <span class="w-5 h-5 rounded-full bg-white/10 flex items-center justify-center text-white shrink-0">
                      ✓
                    </span>
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>

              <div class="pt-4">
                <a href={tab.ctaLink} class="btn-sqsp-primary group !py-3 !px-6 text-sm">
                  <span>{tab.ctaText}</span>
                  <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
                </a>
              </div>
            </div>

            <!-- Right Visual Column -->
            <div class="lg:col-span-7 relative">
              <div class="relative rounded-2xl overflow-hidden aspect-[4/3] sm:aspect-[16/10] bg-neutral-900 border border-white/10 shadow-2xl group">
                <img
                  src={tab.image}
                  alt={tab.headline}
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                />

                <!-- Dark Gradient Overlay -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>

                <!-- Floating Micro Interaction Card -->
                <div class="absolute bottom-6 left-6 right-6 bg-black/80 backdrop-blur-xl border border-white/15 p-4 rounded-xl flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-xs">
                      $
                    </div>
                    <div>
                      <p class="text-xs text-neutral-400">Integrated Payment Flow</p>
                      <p class="text-sm font-semibold text-white">Apple Pay, Stripe & Klarna Ready</p>
                    </div>
                  </div>
                  <span class="text-xs font-semibold text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-full">
                    Instant Payouts
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function setupGrowTabs() {
    const triggers = document.querySelectorAll<HTMLButtonElement>(".tab-trigger");
    const panels = document.querySelectorAll<HTMLElement>(".tab-panel");

    triggers.forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const targetId = trigger.getAttribute("data-tab-target");
        if (!targetId) return;

        // Reset all buttons
        triggers.forEach((btn) => {
          btn.classList.remove("bg-white", "text-black", "shadow-lg");
          btn.classList.add("bg-white/5", "text-neutral-400", "border-white/5");
        });

        // Activate clicked button
        trigger.classList.add("bg-white", "text-black", "shadow-lg");
        trigger.classList.remove("bg-white/5", "text-neutral-400", "border-white/5");

        // Hide all panels
        panels.forEach((panel) => {
          panel.classList.add("hidden", "opacity-0");
          panel.classList.remove("block", "opacity-100");
        });

        // Show target panel
        const activePanel = document.getElementById(`tab-panel-${targetId}`);
        if (activePanel) {
          activePanel.classList.remove("hidden");
          setTimeout(() => {
            activePanel.classList.add("block", "opacity-100");
          }, 10);
        }
      });
    });
  }

  setupGrowTabs();
  document.addEventListener("astro:page-load", setupGrowTabs);
</script>
