---
import { creatorShowcaseData } from "@/lib/site-content";
---

<section id="made-with-sqsp" class="py-20 lg:py-32 bg-black border-b border-white/10 relative">
  <div class="sqsp-container">
    <!-- Header with Scroll Reveal -->
    <div class="max-w-3xl mb-16 reveal-on-scroll">
      <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3 block">
        Customer Stories
      </span>
      <h2 class="sqsp-headline-lg font-medium text-white mb-4">
        {creatorShowcaseData.title}
      </h2>
      <p class="sqsp-body-lg text-neutral-400">
        {creatorShowcaseData.subtitle}
      </p>
    </div>

    <!-- 3 Stories Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {creatorShowcaseData.items.map((item) => (
        <div class="group bg-neutral-950 border border-white/10 hover:border-white/25 rounded-3xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 reveal-on-scroll">
          <!-- Image Container -->
          <div class="relative aspect-[4/3] overflow-hidden bg-neutral-900">
            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>

            <div class="absolute top-4 left-4">
              <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-black/75 backdrop-blur-md text-white border border-white/15">
                {item.location}
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4">
              <h3 class="text-xl font-medium text-white">
                {item.name}
              </h3>
              <p class="text-xs text-neutral-300">
                {item.category}
              </p>
            </div>
          </div>

          <!-- Quote & Footer -->
          <div class="p-6 sm:p-8 space-y-6 flex-1 flex flex-col justify-between">
            <p class="text-sm text-neutral-300 italic leading-relaxed">
              "{item.quote}"
            </p>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="text-xs text-neutral-400 font-medium">Made with Squarespace</span>
              <a href={item.link} class="text-xs font-semibold text-white group-hover:underline flex items-center gap-1">
                View Site →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
