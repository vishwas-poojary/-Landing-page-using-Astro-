---
import { supportData } from "@/lib/site-content";
---

<section id="support" class="py-20 lg:py-28 bg-neutral-950 border-b border-white/10 relative">
  <div class="sqsp-container">
    <div class="max-w-3xl mb-16 reveal-on-scroll">
      <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3 block">
        Always By Your Side
      </span>
      <h2 class="sqsp-headline-lg font-medium text-white mb-4">
        {supportData.title}
      </h2>
      <p class="sqsp-body-lg text-neutral-400">
        {supportData.subtitle}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {supportData.cards.map((card) => (
        <div class="group bg-black/60 border border-white/10 hover:border-white/30 rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 reveal-on-scroll">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-white mb-6 group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
              </svg>
            </div>

            <h3 class="text-xl font-medium text-white">
              {card.title}
            </h3>

            <p class="text-sm text-neutral-400 leading-relaxed">
              {card.description}
            </p>
          </div>

          <div class="pt-6 mt-6 border-t border-white/10">
            <a href={card.href} class="text-xs font-semibold text-white group-hover:underline flex items-center gap-1.5">
              <span>{card.linkText}</span>
              <span class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
