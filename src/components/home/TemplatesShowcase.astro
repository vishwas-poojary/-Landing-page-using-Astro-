---
import { templatesData } from "@/lib/site-content";
---

<section id="templates" class="py-20 lg:py-32 bg-neutral-950 border-b border-white/10 relative">
  <div class="sqsp-container">
    <!-- Header with Scroll Reveal -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between mb-12 gap-6 reveal-on-scroll">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-widest text-neutral-400 mb-3 block">
          {templatesData.tag}
        </span>
        <h2 class="sqsp-headline-lg font-medium text-white mb-4">
          {templatesData.title}
        </h2>
        <p class="sqsp-body-lg text-neutral-400">
          {templatesData.subtitle}
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2">
        {templatesData.categories.map((cat, idx) => (
          <button
            type="button"
            data-template-filter={cat}
            class={`template-filter-btn px-4 py-2 rounded-full text-xs font-medium transition-all cursor-pointer ${
              idx === 0
                ? "bg-white text-black shadow-md"
                : "bg-white/5 text-neutral-400 hover:text-white hover:bg-white/10 border border-white/5"
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    <!-- Templates Grid -->
    <div id="templates-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {templatesData.items.map((item) => (
        <div
          data-template-cat={item.category}
          class="template-card group bg-black/60 border border-white/10 hover:border-white/30 rounded-3xl overflow-hidden transition-all duration-300 hover:-translate-y-1.5 flex flex-col justify-between"
        >
          <!-- Card Image & Hover Overlay -->
          <div class="relative aspect-[16/11] overflow-hidden bg-neutral-900">
            <img
              src={item.image}
              alt={item.name}
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />

            <!-- Hover Backdrop & Quick Actions -->
            <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-3 backdrop-blur-xs p-4">
              <a href="#templates" class="btn-sqsp-primary text-xs !py-2.5 !px-5 shadow-xl">
                Start with {item.name} →
              </a>
              <button
                type="button"
                data-preview-name={item.name}
                class="btn-sqsp-secondary text-xs !py-2.5 !px-4 preview-trigger"
              >
                Preview
              </button>
            </div>

            <!-- Category badge -->
            <div class="absolute top-4 left-4 pointer-events-none">
              <span class="px-3 py-1 rounded-full text-[11px] font-semibold bg-black/75 backdrop-blur-md text-white border border-white/15">
                {item.category}
              </span>
            </div>
          </div>

          <!-- Card Content Footer -->
          <div class="p-6 space-y-2">
            <div class="flex items-center justify-between">
              <h3 class="text-xl font-medium text-white group-hover:text-neutral-200">
                {item.name}
              </h3>
              <span class="text-xs text-neutral-500 font-medium font-mono">
                {item.style}
              </span>
            </div>
            <p class="text-xs text-neutral-400">
              {item.features}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Action -->
    <div class="mt-16 text-center">
      <a href="#templates" class="btn-sqsp-secondary text-sm !py-3 !px-8">
        Browse all 150+ website templates →
      </a>
    </div>
  </div>
</section>

<script>
  function setupTemplateFilters() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>(".template-filter-btn");
    const cards = document.querySelectorAll<HTMLElement>(".template-card");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.getAttribute("data-template-filter");
        if (!cat) return;

        filterBtns.forEach((b) => {
          b.classList.remove("bg-white", "text-black", "shadow-md");
          b.classList.add("bg-white/5", "text-neutral-400", "border-white/5");
        });

        btn.classList.add("bg-white", "text-black", "shadow-md");
        btn.classList.remove("bg-white/5", "text-neutral-400", "border-white/5");

        cards.forEach((card) => {
          const cardCat = card.getAttribute("data-template-cat");
          if (cat === "All" || cardCat === cat) {
            card.classList.remove("hidden");
          } else {
            card.classList.add("hidden");
          }
        });
      });
    });
  }

  setupTemplateFilters();
  document.addEventListener("astro:page-load", setupTemplateFilters);
</script>
