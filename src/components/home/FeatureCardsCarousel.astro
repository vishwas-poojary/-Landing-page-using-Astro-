---
---

<section id="features-carousel" class="py-24 lg:py-32 bg-black text-white relative overflow-hidden">
  <div class="sqsp-container">
    
    <!-- 4 Feature Cards Grid / Horizontal Carousel (Matching Screenshot 3) -->
    <div
      id="cards-track"
      class="flex gap-6 overflow-x-auto no-scrollbar snap-x snap-mandatory pb-8 pt-4 items-stretch"
    >
      <!-- Card 1: Website Editing -->
      <div class="shrink-0 w-[85vw] sm:w-[380px] lg:w-[410px] snap-center rounded-2xl bg-[#141518] border border-white/10 p-7 flex flex-col justify-between hover:border-white/25 transition-all duration-300 group cursor-pointer shadow-xl">
        <div>
          <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
            Website Editing
          </h3>
          <p class="text-sm text-neutral-400 mt-3 leading-relaxed">
            Easily customize every design detail with our next-generation drag-and-drop editor.
          </p>
        </div>

        <!-- Mockup Visual -->
        <div class="my-8 rounded-xl bg-neutral-900 border border-white/10 p-4 aspect-[4/3] flex flex-col justify-between relative overflow-hidden">
          <!-- Top bar with font swatch -->
          <div class="flex items-center justify-between pb-2 border-b border-white/10 text-xs">
            <span class="text-neutral-500 font-mono">Layout grid</span>
            <div class="flex items-center gap-1.5 bg-white/10 px-2 py-0.5 rounded text-[10px] text-neutral-300">
              <span class="font-serif">Aa</span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-200"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-stone-600"></span>
            </div>
          </div>

          <!-- Content block preview -->
          <div class="grid grid-cols-2 gap-3 items-center my-auto">
            <div class="rounded-lg overflow-hidden aspect-square bg-neutral-800">
              <img
                src="https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&w=400&q=80"
                alt="Ceramics studio vase"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="space-y-2">
              <div class="border border-dashed border-blue-400/80 bg-blue-500/10 p-2 rounded text-[11px] text-white font-medium leading-tight">
                Ceramics studio based in NYC
              </div>
              <span class="inline-block text-[10px] font-semibold text-neutral-300 bg-white/10 px-2.5 py-1 rounded">
                Button
              </span>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end pt-2 text-white/70 group-hover:text-white transition-colors">
          <span class="text-xl transition-transform duration-200 group-hover:translate-x-1.5">→</span>
        </div>
      </div>

      <!-- Card 2: Design Intelligence -->
      <div class="shrink-0 w-[85vw] sm:w-[380px] lg:w-[410px] snap-center rounded-2xl bg-[#141518] border border-white/10 p-7 flex flex-col justify-between hover:border-white/25 transition-all duration-300 group cursor-pointer shadow-xl">
        <div>
          <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
            Design Intelligence
          </h3>
          <p class="text-sm text-neutral-400 mt-3 leading-relaxed">
            Your AI creative partner to generate designs, images, and content tailored just for you.
          </p>
        </div>

        <!-- Video / Animated Visual -->
        <div class="my-8 rounded-xl bg-neutral-900 border border-white/10 aspect-[4/3] relative overflow-hidden flex items-center justify-center">
          <video
            class="w-full h-full object-cover"
            autoplay
            loop
            muted
            playsinline
            preload="metadata"
          >
            <source src="https://media-www.sqspcdn.com/images/components/card-carousel/design-intelligence-3.mp4" type="video/mp4" />
          </video>
          <!-- Floating glass pill overlays -->
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
          <div class="absolute bottom-3 left-3 bg-black/70 backdrop-blur-md border border-white/15 px-3 py-1 rounded-md text-[10px] text-white">
            <span>✨ AI Style Matching</span>
          </div>
        </div>

        <div class="flex items-center justify-end pt-2 text-white/70 group-hover:text-white transition-colors">
          <span class="text-xl transition-transform duration-200 group-hover:translate-x-1.5">→</span>
        </div>
      </div>

      <!-- Card 3: Business Email -->
      <div class="shrink-0 w-[85vw] sm:w-[380px] lg:w-[410px] snap-center rounded-2xl bg-[#141518] border border-white/10 p-7 flex flex-col justify-between hover:border-white/25 transition-all duration-300 group cursor-pointer shadow-xl">
        <div>
          <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
            Business Email
          </h3>
          <p class="text-sm text-neutral-400 mt-3 leading-relaxed">
            Make your business official with Business Email from Google Workspace.
          </p>
        </div>

        <!-- Gmail M emblem + Workspace Desk Mockup -->
        <div class="my-8 rounded-xl bg-neutral-900 border border-white/10 aspect-[4/3] relative overflow-hidden flex items-center justify-center">
          <img
            src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=600&q=80"
            alt="Business workspace desk"
            class="w-full h-full object-cover opacity-60"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-black/40"></div>
          <!-- Google Workspace M Emblem -->
          <div class="relative z-10 w-20 h-20 rounded-full bg-white shadow-2xl flex items-center justify-center border-4 border-white/20">
            <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none">
              <path d="M1.5 5.25V18.75C1.5 19.5784 2.17157 20.25 3 20.25H6V11.25L12 15.75L18 11.25V20.25H21C21.8284 20.25 22.5 19.5784 22.5 18.75V5.25C22.5 4.00736 21.0776 3.32757 20.1 4.05L12 10.125L3.9 4.05C2.92237 3.32757 1.5 4.00736 1.5 5.25Z" fill="#EA4335" />
              <path d="M1.5 5.25V18.75C1.5 19.5784 2.17157 20.25 3 20.25H6V11.25L1.5 7.875V5.25Z" fill="#4285F4" />
              <path d="M18 11.25V20.25H21C21.8284 20.25 22.5 19.5784 22.5 18.75V5.25L18 8.625V11.25Z" fill="#34A853" />
              <path d="M6 11.25V20.25H18V11.25L12 15.75L6 11.25Z" fill="#FBBC04" />
            </svg>
          </div>
        </div>

        <div class="flex items-center justify-end pt-2 text-white/70 group-hover:text-white transition-colors">
          <span class="text-xl transition-transform duration-200 group-hover:translate-x-1.5">→</span>
        </div>
      </div>

      <!-- Card 4: Domains -->
      <div class="shrink-0 w-[85vw] sm:w-[380px] lg:w-[410px] snap-center rounded-2xl bg-[#141518] border border-white/10 p-7 flex flex-col justify-between hover:border-white/25 transition-all duration-300 group cursor-pointer shadow-xl">
        <div>
          <h3 class="text-2xl font-bold tracking-tight text-white font-sans">
            Domains
          </h3>
          <p class="text-sm text-neutral-400 mt-3 leading-relaxed">
            Register your dream domain. Free WHOIS privacy, SSL, and premium DNS included.
          </p>
        </div>

        <!-- Domain Search Mockup matching Screenshot 3 -->
        <div class="my-8 rounded-xl bg-neutral-900 border border-white/10 aspect-[4/3] p-5 relative overflow-hidden flex flex-col justify-center">
          <img
            src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=600&q=80"
            alt="Botanical background"
            class="absolute inset-0 w-full h-full object-cover opacity-35"
            loading="lazy"
          />
          <div class="relative z-10 space-y-3">
            <!-- Search Input Pill -->
            <div class="bg-white text-black px-4 py-2.5 rounded-full flex items-center justify-between shadow-2xl">
              <div class="flex items-center gap-2 text-xs font-medium">
                <span class="text-neutral-500">🔍</span>
                <span class="font-semibold">helloclay</span>
              </div>
              <span class="text-[11px] font-bold text-neutral-600 bg-neutral-100 px-2 py-0.5 rounded-full">
                .com
              </span>
            </div>

            <!-- Floating TLD Pills -->
            <div class="flex flex-wrap items-center justify-end gap-1.5 text-[10px] text-neutral-300">
              <span class="px-2.5 py-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10">.org</span>
              <span class="px-2.5 py-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10">.net</span>
              <span class="px-2.5 py-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10">.info</span>
              <span class="px-2.5 py-1 bg-black/60 backdrop-blur-md rounded-full border border-white/10">.site</span>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end pt-2 text-white/70 group-hover:text-white transition-colors">
          <span class="text-xl transition-transform duration-200 group-hover:translate-x-1.5">→</span>
        </div>
      </div>

    </div>

    <!-- Carousel Controls Strip (Matching Screenshot 3) -->
    <div class="mt-4 flex items-center justify-between pt-4 border-t border-white/10">
      <!-- Dots indicator -->
      <div class="flex items-center gap-2">
        <span class="w-6 h-1.5 bg-white rounded-full transition-all"></span>
        <span class="w-1.5 h-1.5 bg-neutral-600 rounded-full transition-all hover:bg-neutral-400 cursor-pointer"></span>
        <span class="w-1.5 h-1.5 bg-neutral-600 rounded-full transition-all hover:bg-neutral-400 cursor-pointer"></span>
        <span class="w-1.5 h-1.5 bg-neutral-600 rounded-full transition-all hover:bg-neutral-400 cursor-pointer"></span>
      </div>

      <!-- Arrow Buttons -->
      <div class="flex items-center gap-3">
        <button
          id="carousel-prev-btn"
          class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Previous card"
        >
          ‹
        </button>
        <button
          id="carousel-next-btn"
          class="w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white hover:bg-white/10 transition-colors cursor-pointer"
          aria-label="Next card"
        >
          ›
        </button>
      </div>
    </div>

  </div>
</section>

<script>
  function setupFeaturesCarousel() {
    const track = document.getElementById("cards-track");
    const prevBtn = document.getElementById("carousel-prev-btn");
    const nextBtn = document.getElementById("carousel-next-btn");

    prevBtn?.addEventListener("click", () => {
      track?.scrollBy({ left: -420, behavior: "smooth" });
    });

    nextBtn?.addEventListener("click", () => {
      track?.scrollBy({ left: 420, behavior: "smooth" });
    });
  }

  setupFeaturesCarousel();
  document.addEventListener("astro:page-load", setupFeaturesCarousel);
</script>
