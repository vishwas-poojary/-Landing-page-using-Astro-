---
const avatars = [
  {
    src: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80",
    alt: "Entrepreneur portrait yellow cap",
  },
  {
    src: "https://images.unsplash.com/photo-1517841905240-472988babdf9?auto=format&fit=crop&w=150&q=80",
    alt: "Entrepreneur portrait woman smiling",
  },
  {
    src: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80",
    alt: "Entrepreneur portrait young man curly hair",
  },
  {
    src: "https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=150&q=80",
    alt: "Entrepreneur portrait woman glasses",
  },
  {
    src: "https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?auto=format&fit=crop&w=150&q=80",
    alt: "Entrepreneur portrait creative artist",
  },
];
---

<section
  id="domain-search-section"
  class="relative bg-black text-white pt-24 sm:pt-32 pb-16 sm:pb-24 overflow-hidden select-none"
  aria-label="Domain Search and Social Proof"
>
  <div class="sqsp-container max-w-4xl mx-auto px-6 sm:px-8 text-center">
    <!-- Main Headline matching Screenshot 1 -->
    <h2 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-white leading-[1.06] mb-10 sm:mb-14">
      Find the perfect domain<br />for your website
    </h2>

    <!-- Search Pill Bar matching Screenshot 1 -->
    <div class="relative max-w-2xl mx-auto">
      <form
        id="hero-domain-form"
        class="bg-[#18191c] hover:bg-[#1f2024] focus-within:bg-[#1f2024] border border-white/15 focus-within:border-white/35 rounded-full px-5 sm:px-7 py-3.5 sm:py-4 flex items-center justify-between gap-3 shadow-2xl transition-all duration-200"
      >
        <!-- Magnifying Glass Icon -->
        <div class="flex items-center gap-3.5 flex-1">
          <svg class="w-5 h-5 text-neutral-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>

          <!-- Input field -->
          <input
            id="domain-search-input"
            type="text"
            placeholder="Start your search here"
            class="w-full bg-transparent text-white placeholder-neutral-500 text-sm sm:text-base focus:outline-none py-1 font-sans"
            autocomplete="off"
            spellcheck="false"
          />
        </div>

        <!-- Circular Submit Arrow Button matching Screenshot 1 -->
        <button
          type="submit"
          class="w-9 h-9 sm:w-10 sm:h-10 rounded-full bg-white/10 hover:bg-white text-white hover:text-black flex items-center justify-center transition-all duration-200 shrink-0 cursor-pointer shadow-md hover:scale-105"
          aria-label="Search Domain"
        >
          <span class="text-sm sm:text-base">→</span>
        </button>
      </form>

      <!-- Instant Search Feedback Simulator -->
      <div
        id="domain-instant-feedback"
        class="hidden mt-4 bg-neutral-950/90 border border-white/15 rounded-2xl p-4 text-left shadow-2xl animate-fade-in"
      >
        <div class="flex items-center justify-between text-xs text-neutral-300">
          <span id="domain-feedback-name" class="font-mono font-bold text-white"></span>
          <span class="text-emerald-400 font-medium bg-emerald-500/10 px-2 py-0.5 rounded-full">
            Available • $12/year
          </span>
        </div>
      </div>
    </div>

    <!-- Transfer Domain Link matching Screenshot 1 -->
    <div class="mt-6 sm:mt-8">
      <p class="text-xs sm:text-[13px] text-neutral-400 font-normal">
        Already have a domain?{" "}
        <a href="#transfer" class="text-neutral-300 underline underline-offset-4 hover:text-white transition-colors">
          Transfer your domain
        </a>
      </p>
    </div>

    <!-- Social Proof Avatar Stack matching Screenshot 1 & 3 -->
    <div class="mt-20 sm:mt-28 flex flex-col items-center justify-center">
      <!-- 5 Overlapping Circular Avatars -->
      <div class="flex items-center justify-center -space-x-3.5 mb-6 sm:mb-8">
        {avatars.map((av, idx) => (
          <div
            class="relative rounded-full overflow-hidden w-12 h-12 sm:w-14 sm:h-14 border-2 border-black shadow-lg transform transition-transform duration-200 hover:scale-110 hover:z-20"
            style={`z-index: ${10 + idx};`}
          >
            <img
              src={av.src}
              alt={av.alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
        ))}
      </div>

      <!-- Trust Headline matching Screenshot 1 & 3 -->
      <h3 class="font-sans text-3xl sm:text-4xl lg:text-5xl font-normal tracking-tight text-white leading-[1.1] max-w-xl">
        Trusted by 14 million<br />entrepreneurs worldwide
      </h3>
    </div>
  </div>
</section>

<script>
  function setupDomainSearch() {
    const form = document.getElementById("hero-domain-form");
    const input = document.getElementById("domain-search-input") as HTMLInputElement | null;
    const feedback = document.getElementById("domain-instant-feedback");
    const nameEl = document.getElementById("domain-feedback-name");

    if (!form || !input) return;

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (val && feedback && nameEl) {
        const domain = val.includes(".") ? val : `${val}.com`;
        nameEl.textContent = domain;
        feedback.classList.remove("hidden");
      }
    });

    input.addEventListener("input", () => {
      if (input.value.length === 0 && feedback) {
        feedback.classList.add("hidden");
      }
    });
  }

  setupDomainSearch();
  document.addEventListener("astro:page-load", setupDomainSearch);
</script>
