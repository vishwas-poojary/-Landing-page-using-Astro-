---
const templatesGrid = [
  {
    name: "RESEDA",
    category: "Art & Photography",
    tagline: "LA-BASED PHOTOGRAPHY BY SEPH REED",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-800",
  },
  {
    name: "SYNC",
    category: "Architecture",
    tagline: "ELEVATED SPATIAL DESIGN",
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-900",
  },
  {
    name: "ALMAR",
    category: "Fashion",
    tagline: "SLOW FASHION & ATELIER APPAREL",
    image: "https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-850",
  },
  {
    name: "CULINARY",
    category: "Hospitality",
    tagline: "CELEBRATING PLANT-BASED CULINARY CRAFT",
    image: "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-800",
  },
  {
    name: "HEALER",
    category: "Wellness",
    tagline: "MINDFUL HOLISTIC RETREATS",
    image: "https://images.unsplash.com/photo-1506126613408-eca07ce68773?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-900",
  },
  {
    name: "STUDIO",
    category: "Fine Art",
    tagline: "FINE ART PAINTER & PRINTMAKER",
    image: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=400&q=80",
    theme: "bg-neutral-850",
  },
];
---

<section
  id="ai-features-section"
  class="relative bg-gradient-to-b from-white via-neutral-100/50 to-neutral-200/40 text-black py-24 sm:py-32 overflow-hidden select-none"
  aria-label="AI Feature Comparison and Templates"
>
  <div class="sqsp-container max-w-[1560px] mx-auto px-4 sm:px-8">
    <!-- Section Header matching Screenshot 1 & 2 -->
    <div class="text-center max-w-3xl mx-auto mb-14 sm:mb-20">
      <h2 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-normal tracking-tight text-neutral-900 leading-[1.08]">
        Getting started has never<br />been easier with AI
      </h2>
      <p class="text-sm sm:text-base text-neutral-600 mt-4 font-normal">
        No experience required.
      </p>
    </div>

    <!-- 2-Column Split Cards matching Screenshot 1 & 2 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10 items-stretch">
      <!-- Left Card: Blueprint AI Builder -->
      <div
        class="group relative bg-[#0e0f12] text-white rounded-3xl sm:rounded-[32px] p-8 sm:p-12 lg:p-14 border border-white/10 flex flex-col justify-between overflow-hidden shadow-2xl min-h-[580px] sm:min-h-[640px]"
      >
        <!-- Iconic Red TIME Best Inventions Badge matching Screenshots 1 & 2 -->
        <div class="absolute top-8 left-8 sm:top-10 sm:left-10 z-30">
          <div class="relative bg-[#e61919] text-white px-3 py-2.5 rounded-[4px] shadow-2xl flex flex-col items-center justify-center text-center tracking-tight border border-red-500/30">
            <span class="text-[9px] sm:text-[10px] font-black uppercase tracking-wider leading-none">TIME</span>
            <span class="text-[8px] font-bold uppercase leading-tight mt-0.5">BEST</span>
            <span class="text-[7px] font-semibold uppercase leading-none opacity-90">INVENTIONS</span>
            <span class="text-[9px] font-bold uppercase leading-tight mt-0.5">2025*</span>
            <!-- Ribbon bottom points -->
            <div class="absolute -bottom-1.5 left-0 right-0 flex justify-center">
              <div class="w-0 h-0 border-x-[18px] border-x-transparent border-t-[6px] border-t-[#e61919]"></div>
            </div>
          </div>
        </div>

        <!-- Visual Mockup Canvas matching Screenshot 1 & 2 -->
        <div class="relative w-full aspect-[16/11] sm:aspect-[16/10] bg-neutral-950/80 rounded-2xl overflow-hidden border border-white/10 p-6 flex flex-col justify-center items-center my-auto shadow-inner">
          <!-- Background E-Commerce mockup artwork from Screenshot 1 -->
          <div class="absolute inset-0 opacity-40 flex flex-col justify-between p-6 pointer-events-none">
            <div class="flex items-start justify-end">
              <div class="text-right space-y-1">
                <span class="text-xs font-bold text-white uppercase block">Shop our Products</span>
                <span class="text-[9px] text-neutral-400 block max-w-[140px]">Formulated with botanical oils and wildcrafted extracts.</span>
              </div>
            </div>
            <div class="flex items-end justify-start">
              <div class="space-y-1">
                <span class="text-xs font-bold text-white uppercase block">Book a Service</span>
                <span class="text-[9px] text-neutral-400 block">Custom bespoke shade matching.</span>
              </div>
            </div>
          </div>

          <!-- Interactive Simulated Typing & Selection Pill matching Screenshot 2 -->
          <div
            id="ai-simulated-pill"
            class="relative z-20 w-full max-w-md bg-neutral-900/95 backdrop-blur-2xl border border-white/20 rounded-2xl p-4 sm:p-5 shadow-[0_20px_50px_rgba(0,0,0,0.8)] transition-all duration-300 hover:border-white/40"
          >
            <div class="flex items-center gap-3">
              <!-- Circular pulsing glowing dot -->
              <div class="w-4 h-4 rounded-full bg-white flex items-center justify-center shrink-0">
                <div class="w-2 h-2 rounded-full bg-neutral-900 animate-ping"></div>
              </div>
              <div class="flex-1">
                <span class="text-[9px] sm:text-[10px] text-neutral-400 uppercase tracking-widest font-mono block">
                  What's your site called?
                </span>
                <span
                  id="ai-typing-text"
                  class="text-xl sm:text-2xl lg:text-3xl font-medium text-white tracking-tight font-sans block mt-0.5"
                >
                  Bella's Beauty
                </span>
              </div>
              <!-- Checkmark icon -->
              <span class="text-emerald-400 text-sm font-bold bg-emerald-500/10 px-2 py-1 rounded-full">
                ✓
              </span>
            </div>
          </div>
        </div>

        <!-- Bottom Content Block -->
        <div class="pt-8">
          <span class="text-xs uppercase font-bold tracking-widest text-neutral-400 block">
            Blueprint AI Builder
          </span>
          <p class="text-sm sm:text-base text-neutral-300 mt-2 font-normal leading-relaxed">
            Answer a few questions and let our AI website builder do the rest.
          </p>
          <a
            href="#ai-builder"
            class="inline-flex items-center gap-1.5 text-sm sm:text-base font-bold text-white hover:text-neutral-300 transition-colors mt-4 group"
          >
            <span>Build with AI</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>

      <!-- Right Card: Professional Templates -->
      <div
        class="group relative bg-[#0e0f12] text-white rounded-3xl sm:rounded-[32px] p-8 sm:p-12 lg:p-14 border border-white/10 flex flex-col justify-between overflow-hidden shadow-2xl min-h-[580px] sm:min-h-[640px]"
      >
        <!-- 6-Item Visual Template Thumbnail Grid matching Screenshots 1 & 2 -->
        <div class="relative w-full aspect-[16/11] sm:aspect-[16/10] bg-neutral-950/80 rounded-2xl overflow-hidden border border-white/10 p-3 sm:p-4 my-auto shadow-inner">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 sm:gap-3 h-full">
            {templatesGrid.map((tmpl) => (
              <div
                class={`relative rounded-xl overflow-hidden ${tmpl.theme} border border-white/10 flex flex-col justify-between p-2.5 sm:p-3 group/tmpl hover:border-white/30 transition-all duration-300`}
              >
                <!-- Thumbnail Image Backdrop -->
                <img
                  src={tmpl.image}
                  alt={tmpl.name}
                  class="absolute inset-0 w-full h-full object-cover opacity-50 group-hover/tmpl:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/20"></div>

                <!-- Template Mini Badge -->
                <div class="relative z-10 flex items-center justify-between text-[8px] uppercase font-bold tracking-widest text-white/90">
                  <span>{tmpl.name}</span>
                </div>

                <!-- Template Mini Tagline -->
                <div class="relative z-10">
                  <span class="text-[7px] sm:text-[8px] text-neutral-300 uppercase tracking-tight block font-mono line-clamp-2">
                    {tmpl.tagline}
                  </span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Bottom Content Block -->
        <div class="pt-8">
          <span class="text-xs uppercase font-bold tracking-widest text-neutral-400 block">
            Professional Templates
          </span>
          <p class="text-sm sm:text-base text-neutral-300 mt-2 font-normal leading-relaxed">
            Crafted by our designers, customized by AI—just for your business.
          </p>
          <a
            href="#templates"
            class="inline-flex items-center gap-1.5 text-sm sm:text-base font-bold text-white hover:text-neutral-300 transition-colors mt-4 group"
          >
            <span>Browse website templates</span>
            <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom Caption matching Screenshots 1 & 2 -->
    <div class="text-center mt-12 sm:mt-16">
      <p class="text-xs sm:text-[13px] text-neutral-500 font-medium tracking-wide">
        Blueprint AI, one of TIME's Best Inventions of 2025*
      </p>
    </div>
  </div>
</section>

<script>
  // Dynamic simulated typing for "Bella's Beauty" matching user specification
  function initAITypingAnimation() {
    const textEl = document.getElementById("ai-typing-text");
    if (!textEl) return;

    const brandNames = ["Bella's Beauty", "Maison Minimal", "Studio Bloom", "Nordic Roast"];
    let nameIdx = 0;
    let charIdx = 0;
    let isDeleting = false;

    function typeLoop() {
      const currentName = brandNames[nameIdx];
      if (isDeleting) {
        charIdx--;
      } else {
        charIdx++;
      }

      textEl!.textContent = currentName.substring(0, charIdx);

      let typingSpeed = isDeleting ? 45 : 90;

      if (!isDeleting && charIdx === currentName.length) {
        typingSpeed = 2200; // Pause at full word
        isDeleting = true;
      } else if (isDeleting && charIdx === 0) {
        isDeleting = false;
        nameIdx = (nameIdx + 1) % brandNames.length;
        typingSpeed = 500;
      }

      setTimeout(typeLoop, typingSpeed);
    }

    setTimeout(typeLoop, 1000);
  }

  initAITypingAnimation();
  document.addEventListener("astro:page-load", initAITypingAnimation);
</script>
