---
const particleVideo = {
  mp4: "https://media-www.sqspcdn.com/images/components/conversion/conversion-centered.mp4",
  poster: "https://media-www.sqspcdn.com/images/components/conversion/conversion-centered-poster-1500w.webp",
};
---

<section
  id="pre-footer-cta"
  class="relative min-h-[85vh] sm:min-h-screen py-24 sm:py-36 bg-black text-white overflow-hidden flex flex-col items-center justify-center text-center select-none"
  aria-label="Start Free Trial CTA"
>
  <!-- Central Glowing Particulate Sphere Background matching Squarespace original -->
  <div class="absolute inset-0 w-full h-full flex items-center justify-center pointer-events-none overflow-hidden z-0">
    <!-- Looping Particle Dome Video matching Squarespace original -->
    <video
      class="w-full h-full max-w-[1400px] max-h-[1080px] object-contain pointer-events-none brightness-90 contrast-105"
      autoplay
      loop
      muted
      playsinline
      preload="auto"
      poster={particleVideo.poster}
      disablepictureinpicture
    >
      <source src={particleVideo.mp4} type="video/mp4" />
    </video>
  </div>

  <!-- Content Container matching original -->
  <div class="relative z-10 w-full max-w-5xl mx-auto px-6 sm:px-8 flex flex-col items-center justify-center">
    <!-- Big Headline -->
    <h2 class="font-sans text-4xl sm:text-5xl md:text-6xl lg:text-[76px] font-normal tracking-[-0.03em] leading-[1.04] text-white drop-shadow-2xl">
      Start your free website trial<br />today
    </h2>

    <!-- Subtext -->
    <p class="text-xs sm:text-sm text-neutral-300 mt-4 sm:mt-5 font-normal tracking-wide drop-shadow">
      No credit card required. Cancel anytime.
    </p>

    <!-- White Pill Button -->
    <div class="mt-8 sm:mt-9">
      <a
        href="#templates"
        class="inline-flex items-center justify-center bg-white text-black hover:bg-neutral-100 font-bold uppercase tracking-[0.08em] text-xs sm:text-sm px-9 sm:px-11 py-3.5 sm:py-4 rounded-[4px] shadow-2xl transition-all duration-200 hover:scale-[1.02] cursor-pointer"
      >
        GET STARTED
      </a>
    </div>
  </div>
</section>
