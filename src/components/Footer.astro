---
const productLinks = [
  "Website Templates",
  "Websites",
  "Domains",
  "AI Website Builder",
  "Design Intelligence",
  "Online Stores",
  "Services",
  "Invoicing",
  "Scheduling",
  "Content & Memberships",
  "Donations",
  "Payments",
  "Marketing Tools",
  "Professional Email",
  "Feature List",
  "Product Updates",
  "Pricing",
];

const solutionLinks = [
  "Creative Services",
  "Professional Services",
  "Education & Training",
  "Beauty",
  "Sports & Fitness",
  "Health & Wellness",
  "Home Services",
  "Events & Experiences",
  "Charities & Nonprofits",
  "Personal",
];

const resourceLinks = [
  "Customer Examples",
  "Squarespace Collection",
  "Extensions",
  "Squarespace Blog",
  "Free Tools",
  "Business Name Generator",
  "Logo Maker",
];

const fromSqspLinks = [
  "Acuity Scheduling",
  "Bio Sites",
  "Unfold",
  "Email Campaigns",
  "Squarespace for Pros",
];

const programLinks = ["Circle", "Affiliates", "Students"];

const supportLinks = [
  "Help Center",
  "Forum",
  "Webinars",
  "Hire an Expert",
  "Developer Blog",
  "Developer Platform",
  "System Status",
];

const companyLinks = [
  "About",
  "Careers",
  "Our Brand",
  "Accessibility",
  "Newsroom",
  "Press & Media",
  "Contact Us",
];

const followLinks = ["Instagram", "YouTube", "LinkedIn", "Facebook", "X"];
---

<footer
  id="site-footer"
  class="relative bg-black text-white pt-20 pb-16 border-t border-white/10 select-none"
  aria-label="Site Footer"
>
  <div class="sqsp-container max-w-[1560px] mx-auto px-6 sm:px-10 lg:px-14">
    <!-- Main Footer Grid: Left Brand Column + 4 Link Columns matching Screenshot 1 -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 pb-16">
      
      <!-- Left Brand Column (lg:col-span-3) -->
      <div class="lg:col-span-3 flex flex-col justify-between space-y-8">
        <div>
          <!-- Iconic Squarespace Emblem -->
          <a href="/" class="inline-block text-white group" aria-label="Squarespace Home">
            <svg class="h-8 w-auto text-white transition-transform duration-200 group-hover:scale-105" viewBox="0 0 38 30" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M21.5542 6.19939L23.3865 8.02863L23.3835 8.03156L11.6382 19.7716C10.3536 21.0568 8.63974 21.7655 6.81638 21.7655C4.99302 21.7655 3.27918 21.0568 1.99454 19.7716C-0.663544 17.113 -0.663544 12.7899 1.99454 10.1314L12.1296 0L13.9618 1.82923L3.82678 11.9606C2.17806 13.6075 2.17806 16.2896 3.82678 17.9394C5.4755 19.5893 8.16022 19.5893 9.80894 17.9394L21.5542 6.19939ZM19.4349 4.12313L7.74291 15.8808L5.92251 14.0486L17.6145 2.29096C18.8932 1.00285 20.5982 0.294098 22.4127 0.294098C24.2272 0.294098 25.9321 1.00285 27.2108 2.29096L28.1225 3.20558L26.2992 5.03775L25.3875 4.12313C24.5942 3.32321 23.5404 2.88502 22.4127 2.88502C21.2849 2.88502 20.2282 3.32321 19.4349 4.12313ZM35.0074 10.2284C33.7228 8.94325 32.0089 8.2345 30.1856 8.2345C28.3622 8.2345 26.6484 8.94325 25.3637 10.2284L13.6184 21.9684L15.4477 23.7977L27.193 12.0577C28.8417 10.4078 31.5265 10.4108 33.1752 12.0577C33.9714 12.8546 34.4125 13.9163 34.4125 15.0485C34.4125 16.1808 33.9744 17.2424 33.1752 18.0394L23.0401 28.1708L24.8724 30L35.0074 19.8687C37.6655 17.2101 37.6655 12.887 35.0074 10.2284ZM29.2606 14.1178L29.262 14.1163H29.2591L29.2606 14.1178ZM29.2606 14.1178L17.57 25.8739C15.9272 27.5238 13.2573 27.5267 11.6145 25.8739L10.7028 24.9593L8.87947 26.7915L9.79115 27.7061C11.0699 28.9942 12.7748 29.703 14.5893 29.703C16.4038 29.703 18.1088 28.9942 19.3875 27.7061L31.0795 15.9484L29.2606 14.1178Z" />
            </svg>
          </a>

          <!-- Brand Slogan matching Screenshot 1 -->
          <p class="font-sans text-xl sm:text-2xl font-normal text-white mt-8 tracking-tight max-w-xs leading-snug">
            A website makes it real
          </p>
        </div>

        <!-- ICANN Accredited Registrar Badge matching Screenshot 1 -->
        <div class="pt-8 sm:pt-16 mt-auto">
          <div class="flex items-center gap-3 text-neutral-400">
            <!-- ICANN Logo Graphic -->
            <svg class="w-8 h-8 text-neutral-400 shrink-0" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5">
              <circle cx="20" cy="20" r="16" />
              <ellipse cx="20" cy="20" rx="9" ry="16" />
              <line x1="4" y1="20" x2="36" y2="20" />
              <line x1="6" y1="12" x2="34" y2="12" />
              <line x1="6" y1="28" x2="34" y2="28" />
            </svg>
            <span class="text-[11px] sm:text-xs leading-tight text-neutral-400">
              We are an ICANN<br />accredited registrar.
            </span>
          </div>
        </div>
      </div>

      <!-- Right 4 Link Columns (lg:col-span-9) -->
      <div class="lg:col-span-9 grid grid-cols-2 md:grid-cols-4 gap-8 sm:gap-10">
        
        <!-- Column 1: Products -->
        <div class="space-y-4">
          <h4 class="text-xs font-bold uppercase tracking-wider text-white">
            Products
          </h4>
          <ul class="space-y-2.5">
            {productLinks.map((link) => (
              <li>
                <a href="#templates" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                  {link}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 2: Solutions & Resources -->
        <div class="space-y-8">
          <!-- Solutions -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Solutions
            </h4>
            <ul class="space-y-2.5">
              {solutionLinks.map((link) => (
                <li>
                  <a href="#solutions" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Resources -->
          <div class="space-y-4 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Resources
            </h4>
            <ul class="space-y-2.5">
              {resourceLinks.map((link) => (
                <li>
                  <a href="#resources" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Column 3: From Squarespace, Programs & Support -->
        <div class="space-y-8">
          <!-- From Squarespace -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              From Squarespace
            </h4>
            <ul class="space-y-2.5">
              {fromSqspLinks.map((link) => (
                <li>
                  <a href="#" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Programs -->
          <div class="space-y-4 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Programs
            </h4>
            <ul class="space-y-2.5">
              {programLinks.map((link) => (
                <li>
                  <a href="#" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Support -->
          <div class="space-y-4 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Support
            </h4>
            <ul class="space-y-2.5">
              {supportLinks.map((link) => (
                <li>
                  <a href="#" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Column 4: Company & Follow links -->
        <div class="space-y-8">
          <!-- Company -->
          <div class="space-y-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Company
            </h4>
            <ul class="space-y-2.5">
              {companyLinks.map((link) => (
                <li>
                  <a href="#" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Follow -->
          <div class="space-y-4 pt-2">
            <h4 class="text-xs font-bold uppercase tracking-wider text-white">
              Follow
            </h4>
            <ul class="space-y-2.5">
              {followLinks.map((link) => (
                <li>
                  <a href="#" class="text-xs sm:text-[13px] text-neutral-400 hover:text-white transition-colors duration-150">
                    {link}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

      </div>
    </div>

    <!-- Bottom Copyright & Legal Links -->
    <div class="pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500">
      <p>© {new Date().getFullYear()} Squarespace, Inc. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-neutral-300 transition-colors">Terms of Service</a>
        <a href="#" class="hover:text-neutral-300 transition-colors">Privacy Policy</a>
        <a href="#" class="hover:text-neutral-300 transition-colors">Cookie Policy</a>
      </div>
    </div>
  </div>
</footer>
