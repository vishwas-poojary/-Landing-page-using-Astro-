const websiteSteps = [
  {
    step: "01",
    title: "Choose a template",
    description: "Start with an award-winning designer template tailored for your industry or use Blueprint AI to generate a custom foundation.",
  },
  {
    step: "02",
    title: "Claim your custom domain",
    description: "Search and register a memorable domain name or connect one you already own with free WHOIS privacy and SSL included.",
  },
  {
    step: "03",
    title: "Add content & customize styling",
    description: "Use Fluid Engine™ drag-and-drop technology to arrange blocks, adjust typography, insert photos, and package products or services.",
  },
  {
    step: "04",
    title: "Publish and grow",
    description: "Launch your site, optimize SEO, and power your marketing with integrated email campaigns and social media integrations.",
  },
];
---

<section
  id="cylinder-gallery-section"
  class="relative bg-black text-white pt-16 sm:pt-24 pb-20 sm:pb-32 overflow-hidden select-none"
  aria-label="Made with Squarespace 3D Gallery"
>
  <!-- 3D Perspective Stage Container -->
  <div class="relative w-full overflow-hidden min-h-[520px] sm:min-h-[640px] flex items-center justify-center">
    <!-- 3D Curved Cylindrical Track Container -->
    <div class="w-full flex items-center justify-center perspective-[1400px]">
      <div
        id="cylinder-3d-track"
        class="relative w-full max-w-[1500px] h-[480px] sm:h-[580px] flex items-center justify-center transform-style-3d will-change-transform"
        style="transform: translateZ(-60px);"
      >
        {galleryCards.map((card, idx) => {
          // Calculate angle on 3D cylindrical ring
          const total = galleryCards.length;
          const angle = (idx / total) * 360;
          const radius = 600; // 3D cylinder radius in px

          return (
            <div
              class="cylinder-card absolute w-[240px] sm:w-[300px] lg:w-[340px] aspect-[4/3] rounded-2xl overflow-hidden border border-white/15 shadow-2xl transition-all duration-300 hover:border-white/50 cursor-pointer group"
              data-card-angle={angle}
              style={`
                transform: rotateY(${angle}deg) translateZ(${radius}px);
                transform-style: preserve-3d;
              `}
            >
              <!-- Mockup Card Body -->
              <div class={`w-full h-full ${card.bgClass} relative flex flex-col justify-between p-3.5 sm:p-4`}>
                <img
                  src={card.image}
                  alt={card.title}
                  class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500 pointer-events-none"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/30"></div>

                <!-- Mini Top Bar -->
                <div class="relative z-10 flex items-center justify-between text-[8px] uppercase tracking-wider opacity-80">
                  <span class="font-bold">{card.title}</span>
                  <span>View Site →</span>
                </div>

                <!-- Mini Bottom Label -->
                <div class="relative z-10">
                  <span class="text-[9px] font-sans font-semibold text-white block">
                    {card.title}
                  </span>
                  <span class="text-[7px] uppercase tracking-wider text-neutral-400 block font-mono">
                    {card.category}
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Center Headline Overlay (Always in Foreground in Front of Rotating Cards) -->
    <div class="absolute inset-0 z-30 flex items-center justify-center text-center pointer-events-none px-4">
      <h2 class="font-serif text-3xl sm:text-4xl lg:text-5xl text-white/95 font-normal tracking-tight leading-tight drop-shadow-[0_10px_25px_rgba(0,0,0,0.95)]">
        Made with<br />Squarespace
      </h2>
    </div>
  </div>

  <!-- Bottom Expandable Trigger matching Screenshot 2 -->
  <div class="sqsp-container max-w-5xl mx-auto px-6 sm:px-8 mt-16 sm:mt-24">
    <div class="border-t border-white/15">
      <button
        id="how-to-build-trigger"
        class="w-full flex items-center justify-between py-8 text-left text-2xl sm:text-3xl lg:text-4xl font-normal tracking-tight text-white hover:text-neutral-300 transition-colors cursor-pointer group"
        aria-expanded="false"
      >
        <span>How to build a website</span>
        <span
          id="how-to-build-icon"
          class="text-3xl sm:text-4xl font-light text-neutral-400 group-hover:text-white transition-transform duration-300"
        >
          +
        </span>
      </button>

      <!-- Expandable Accordion Drawer -->
      <div
        id="how-to-build-drawer"
        class="hidden overflow-hidden transition-all duration-500 pb-12 pt-4 border-t border-white/5"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          {websiteSteps.map((item) => (
            <div class="space-y-3 bg-neutral-950/70 border border-white/10 rounded-2xl p-6">
              <span class="text-xs font-mono font-bold text-neutral-500 block">
                {item.step}
              </span>
              <h4 class="text-lg font-semibold text-white tracking-tight">
                {item.title}
              </h4>
              <p class="text-xs text-neutral-400 leading-relaxed font-normal">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initCylinderGallery() {
    const track = document.getElementById("cylinder-3d-track");
    const section = document.getElementById("cylinder-gallery-section");
    const trigger = document.getElementById("how-to-build-trigger");
    const drawer = document.getElementById("how-to-build-drawer");
    const icon = document.getElementById("how-to-build-icon");

    if (track && section) {
      ScrollTrigger.getById("cylinder-gallery-trigger")?.kill();

      // Rotate 3D cylinder full 360 degrees in the background of 'Made with Squarespace'
      // Completes full rotation while section is in view, before scrolling down past it
      gsap.to(track, {
        rotationY: 360,
        rotationX: -4,
        ease: "none",
        scrollTrigger: {
          id: "cylinder-gallery-trigger",
          trigger: section,
          start: "top 80%",
          end: "bottom 90%",
          scrub: 1,
        },
      });
    }

    // Expandable accordion toggle
    if (trigger && drawer && icon) {
      trigger.onclick = () => {
        const isExpanded = trigger.getAttribute("aria-expanded") === "true";
        if (isExpanded) {
          trigger.setAttribute("aria-expanded", "false");
          drawer.classList.add("hidden");
          icon.textContent = "+";
          icon.style.transform = "rotate(0deg)";
        } else {
          trigger.setAttribute("aria-expanded", "true");
          drawer.classList.remove("hidden");
          icon.textContent = "−";
          icon.style.transform = "rotate(180deg)";
        }
      };
    }
  }

  initCylinderGallery();
  document.addEventListener("astro:page-load", initCylinderGallery);
</script>
