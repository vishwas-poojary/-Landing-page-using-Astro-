    image: "https://images.unsplash.com/photo-1518611012118-696072aa579a?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#16171b]",
  },
  {
    title: "Let's connect!",
    category: "Botanical Design",
    image: "https://images.unsplash.com/photo-1487700160041-babef9c3cb55?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#253026]",
  },
  {
    title: "SecondStory",
    category: "Publishing & Media",
    image: "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#e8e4dc] text-neutral-900",
  },
  {
    title: "Flâneur Magazine",
    category: "Independent Press",
    image: "https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#111215]",
  },
  {
    title: "Ceramic Object",
    category: "Handmade Pottery",
    image: "https://images.unsplash.com/photo-1612196808214-b8e1d6145a8c?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#1e2330]",
  },
  {
    title: "Naughty Nancy",
    category: "Restaurant & Bar",
    image: "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#1b1716]",
  },
  {
    title: "A ritual best shared",
    category: "Fragrance & Care",
    image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#e5e4de] text-neutral-900",
  },
  {
    title: "Reseda Architecture",
    category: "Spatial Design",
    image: "https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=600&q=80",
    bgClass: "bg-[#151619]",
  },
