                  <div class="bg-neutral-950/90 backdrop-blur-xl border border-white/15 rounded-2xl p-4 sm:p-6 shadow-[0_20px_50px_rgba(0,0,0,0.6)]">
                    <!-- Browser / Website Mockup Top Header -->
                    <div class="flex items-center justify-between pb-3 sm:pb-4 border-b border-white/10 text-[9px] sm:text-[11px] font-bold tracking-widest uppercase">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-white/70"></span>
                        <span class="text-white font-sans">{card.mockupHeader}</span>
                      </div>
                      <div class="hidden sm:flex items-center gap-4 text-neutral-400 font-medium">
                        {card.mockupNav.map((item) => (
