                <!-- Background Image of the real-world entrepreneur / environment -->
                <img
                  src={card.bgImage}
                  alt={card.bgAlt}
                  class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none opacity-45"
                  loading="lazy"
                />

                <!-- Dark gradient overlay for contrast -->
                <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-black/60 pointer-events-none z-1"></div>

                <!-- Top Card Headline & Description -->
                <div class="relative z-10 max-w-xl">
                  <h3 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-white leading-tight">
                    {card.title}
                  </h3>
                  <p class="text-xs sm:text-sm text-neutral-300 mt-2 sm:mt-3 leading-relaxed max-w-md">
                    {card.subtitle}
                  </p>
                </div>

                <!-- Center Floating UI Mockup Window matching Screenshot 4 -->
