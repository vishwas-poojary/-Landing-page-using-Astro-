                        <div class="w-9 h-9 rounded-lg overflow-hidden shrink-0">
                          <img src={card.floatingLeft.img} alt="Thumb" class="w-full h-full object-cover" />
                        </div>
                        <div class="pr-2">
                          <span class="text-[8px] font-bold uppercase tracking-wider text-neutral-500 block">
                            {card.floatingLeft.tag}
                          </span>
                          <span class="text-[11px] font-bold text-neutral-900 block leading-tight">
                            {card.floatingLeft.title}
                          </span>
                          <span class="text-[9px] text-neutral-600 block">
                            {card.floatingLeft.subtitle}
                          </span>
                        </div>
                      </div>

                      <!-- Floating Right Dropdown ("Layout Picker") -->
                      <div class="hidden md:block absolute -right-6 -bottom-5 bg-white text-black rounded-xl p-3 shadow-2xl border border-black/10 z-20 min-w-[140px]">
                        <span class="text-[8px] font-bold uppercase tracking-wider text-neutral-500 block pb-1 border-b border-neutral-100">
                          {card.floatingRight.title}
                        </span>
                        <div class="pt-1.5 space-y-1 text-[10px]">
