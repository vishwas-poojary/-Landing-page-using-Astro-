                      </div>
                    </div>
                  </div>
                </div>

                <!-- Bottom Right Circular Arrow Button matching Screenshot 4 -->
                <div class="absolute bottom-6 right-6 sm:bottom-8 sm:right-8 z-20">
                  <button
                    class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-white text-black flex items-center justify-center shadow-xl hover:scale-105 transition-all cursor-pointer"
                    aria-label={`Learn more about ${card.title}`}
                  >
                    <span class="text-base sm:text-lg">→</span>
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Carousel Navigation Chevrons & Dots -->
      <div class="flex items-center justify-between max-w-sm mx-auto mt-8 sm:mt-10 px-4">
        <button
          id="showcase-prev-btn"
          class="w-10 h-10 rounded-full border border-neutral-300 hover:border-black flex items-center justify-center text-neutral-700 hover:text-black transition-colors cursor-pointer"
          aria-label="Previous Showcase"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Dots Indicator -->
        <div class="flex items-center gap-2">
          {cardsData.map((_, idx) => (
            <button
              class="showcase-dot w-2 h-2 rounded-full bg-neutral-300 hover:bg-neutral-500 transition-all cursor-pointer"
              data-dot-index={idx}
              aria-label={`Go to slide ${idx + 1}`}
            ></button>
          ))}
        </div>

        <button
          id="showcase-next-btn"
          class="w-10 h-10 rounded-full border border-neutral-300 hover:border-black flex items-center justify-center text-neutral-700 hover:text-black transition-colors cursor-pointer"
          aria-label="Next Showcase"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";

  function initTabbedShowcase() {
    const track = document.getElementById("showcase-track");
    const viewport = document.getElementById("showcase-viewport");
    const slides = Array.from(document.querySelectorAll<HTMLElement>(".showcase-card-slide"));
    const pills = Array.from(document.querySelectorAll<HTMLElement>(".tab-pill-btn"));
    const dots = Array.from(document.querySelectorAll<HTMLElement>(".showcase-dot"));
    const prevBtn = document.getElementById("showcase-prev-btn");
    const nextBtn = document.getElementById("showcase-next-btn");

    if (!track || slides.length === 0 || !viewport) return;

    // Start on "Blog" tab (index 0 in cardsData, matching screenshot 1, 3, 4)
    let currentIndex = 0;
    const totalSlides = slides.length;

    function updateShowcasePosition(animate = true) {
      const viewportWidth = viewport!.offsetWidth;
      const cardWidth = slides[0].offsetWidth;
      const targetOffset = (viewportWidth - cardWidth) / 2 - currentIndex * cardWidth;

      if (animate) {
        gsap.to(track, {
          x: targetOffset,
          duration: 0.75,
          ease: "power3.out",
        });
      } else {
        gsap.set(track, { x: targetOffset });
      }

      // Update card scale and opacity
      slides.forEach((slide, i) => {
        const cardInner = slide.querySelector<HTMLElement>(".showcase-card-inner");
        const isCenter = i === currentIndex;
        const scaleVal = isCenter ? 1 : 0.94;
        const opacityVal = isCenter ? 1 : 0.55;

        slide.style.zIndex = isCenter ? "20" : "10";

        if (cardInner) {
          if (animate) {
            gsap.to(cardInner, {
              scale: scaleVal,
              opacity: opacityVal,
              duration: 0.75,
              ease: "power3.out",
            });
          } else {
            gsap.set(cardInner, {
              scale: scaleVal,
              opacity: opacityVal,
            });
          }
        }
      });

      // Update active tab pill
      const activeCard = slides[currentIndex];
      const activeTabId = activeCard?.getAttribute("data-card-tab");

      pills.forEach((pill) => {
        const pId = pill.getAttribute("data-tab-id");
        if (pId === activeTabId) {
          pill.classList.add("bg-neutral-100", "text-black", "font-semibold", "shadow-xs");
          pill.classList.remove("text-neutral-500");
          pill.setAttribute("aria-selected", "true");
          pill.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
        } else {
          pill.classList.remove("bg-neutral-100", "text-black", "font-semibold", "shadow-xs");
          pill.classList.add("text-neutral-500");
          pill.setAttribute("aria-selected", "false");
        }
      });

      // Update dots indicator
      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add("bg-black", "!w-6", "rounded-full");
          dot.classList.remove("bg-neutral-300");
        } else {
          dot.classList.remove("bg-black", "!w-6");
          dot.classList.add("bg-neutral-300");
        }
      });
    }

    function goToIndex(index: number) {
      currentIndex = (index + totalSlides) % totalSlides;
      updateShowcasePosition(true);
    }

    // Pill tab clicks
    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        const tabId = pill.getAttribute("data-tab-id");
        const foundIdx = slides.findIndex((s) => s.getAttribute("data-card-tab") === tabId);
        if (foundIdx !== -1) {
          goToIndex(foundIdx);
        }
      });
    });

    // Arrow navigation
    prevBtn?.addEventListener("click", () => goToIndex(currentIndex - 1));
    nextBtn?.addEventListener("click", () => goToIndex(currentIndex + 1));

    // Dots navigation
    dots.forEach((dot, idx) => {
      dot.addEventListener("click", () => goToIndex(idx));
    });

    // Clicking peeking card brings it to center
    slides.forEach((slide, idx) => {
      slide.addEventListener("click", () => {
        if (idx !== currentIndex) {
          goToIndex(idx);
        }
      });
    });

    // Touch swipe support
    let startX = 0;
    viewport.addEventListener(
      "touchstart",
      (e) => {
        startX = e.touches[0].clientX;
      },
      { passive: true }
    );

    viewport.addEventListener(
      "touchend",
      (e) => {
        const diff = startX - e.changedTouches[0].clientX;
        if (Math.abs(diff) > 40) {
          if (diff > 0) goToIndex(currentIndex + 1);
          else goToIndex(currentIndex - 1);
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", () => updateShowcasePosition(false));

    updateShowcasePosition(false);
  }

  initTabbedShowcase();
  document.addEventListener("astro:page-load", initTabbedShowcase);
</script>
