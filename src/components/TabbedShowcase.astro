---

<section
  id="tabbed-showcase"
  class="relative bg-white text-black py-24 sm:py-32 overflow-hidden select-none"
  aria-label="Grow Your Business Showcase"
>
  <div class="sqsp-container max-w-[1560px] mx-auto px-4 sm:px-8">
    <!-- Section Header matching Screenshot 1, 3, 4 -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <h2 class="font-sans text-4xl sm:text-5xl lg:text-6xl font-medium tracking-tight text-neutral-900">
        Grow your business
      </h2>
      <p class="text-sm sm:text-base text-neutral-500 mt-3 sm:mt-4 font-normal">
        You deserve a website that can do it all.
      </p>
    </div>

    <!-- Horizontal Pill Tabs matching Screenshots 1, 3, 4 -->
    <div class="flex items-center justify-start md:justify-center gap-1.5 sm:gap-2 overflow-x-auto no-scrollbar pb-6 -mx-4 px-4 sm:mx-0 sm:px-0">
      {tabsList.map((tab, idx) => (
        <button
          type="button"
          data-tab-id={tab.id}
          data-tab-index={idx}
          class={`tab-pill-btn shrink-0 text-xs sm:text-sm font-medium px-4 sm:px-5 py-2 sm:py-2.5 rounded-full transition-all duration-200 cursor-pointer ${
            tab.id === "blog"
              ? "bg-neutral-100 text-black font-semibold shadow-xs"
              : "text-neutral-500 hover:text-black hover:bg-neutral-50"
          }`}
          aria-selected={tab.id === "blog" ? "true" : "false"}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Carousel Container with Multi-card Perspective / Peeking Track -->
    <div class="relative mt-4 sm:mt-8">
      <!-- Carousel Viewport -->
      <div
        id="showcase-viewport"
        class="w-full relative overflow-visible flex items-center justify-center"
      >
        <div
          id="showcase-track"
          class="flex items-center transition-none will-change-transform py-4"
        >
          {cardsData.map((card, idx) => (
            <div
              class="showcase-card-slide shrink-0 px-3 sm:px-5 transition-all duration-500 will-change-transform"
              data-card-index={idx}
              data-card-tab={card.tabId}
              style="width: clamp(340px, 78vw, 1020px);"
            >
              <!-- Card Container with Background Image Backdrop and Layered UI -->
              <div
                class={`showcase-card-inner relative rounded-3xl overflow-hidden aspect-[4/3] sm:aspect-[16/10] md:aspect-[16/9] shadow-2xl border border-neutral-200/60 ${card.accentColor} text-white flex flex-col justify-between p-6 sm:p-10 lg:p-12 transition-all duration-500`}
