    title: "Lio Agency",
    brand: "LIO AGENCY",
    theme: "dark",
    bgClass: "bg-[#111215] text-white",
    headerMenu: ["Work", "Capabilities", "About"],
    headerCta: "Start Project →",
    headlineMain: "LIO",
    headlineSub: "AGENCY",
    author: "NEW YORK / LONDON",
    description: "A creative agency creating identities, imagery, and cultural relevance for iconic brands.",
    image: "https://images.unsplash.com/photo-1522335789203-aabd1fc54bc9?auto=format&fit=crop&w=900&q=80",
    imageAlt: "Minimalist skincare product dropper and luxury packaging",
    video: {
      mp4: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/creative-desktop.mp4",
      webm: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/creative-desktop.webm",
      poster: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/creative-desktop-poster-1500w.webp",
    },
  },
  {
    id: "barber",
    title: "Borough Barber",
    brand: "BOROUGH BARBER",
    theme: "light",
