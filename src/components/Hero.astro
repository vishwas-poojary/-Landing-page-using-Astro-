---
// Video assets from Squarespace CDN matching the official rotating slides
const slidesData = [
  {
    id: "tutor",
    title: "Academic Lessons",
    brand: "SCOTT SMITH TUTORING",
    theme: "light",
    bgClass: "bg-[#f1ebe2] text-neutral-900",
    headerMenu: ["Lessons", "Testimonials", "Rates"],
    headerCta: "Schedule a Lesson",
    headlineMain: "ACADEMIC",
    headlineSub: "LESSONS",
    author: "BY SCOTT SMITH",
    description: "Personalized academic tutoring to build confidence, strengthen skills, and support success.",
    image: "https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=900&q=80",
    imageAlt: "Books and ceramic coffee mug on academic desk",
    video: {
      mp4: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/tutor-desktop.mp4",
      webm: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/tutor-desktop.webm",
      poster: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/tutor-desktop-poster-1500w.webp",
    },
  },
  {
    id: "wellness",
    title: "Balance Wellness",
    brand: "BALANCE",
    theme: "dark",
    bgClass: "bg-[#16171b] text-white",
    headerMenu: ["Services", "Facilities", "Memberships"],
    headerCta: "Bookings →",
    headlineMain: "BALANCE",
    headlineSub: "(WELLNESS CENTER)",
    author: "LOS ANGELES, CA",
    description: "A space designed to help you slow down, reset, and reconnect through holistic therapies.",
    image: "https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=900&q=80",
    imageAlt: "Wellness minimalist stones and tranquility space",
    video: {
      mp4: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/wellness-desktop.mp4",
      webm: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/wellness-desktop.webm",
      poster: "https://media-www.sqspcdn.com/images/pages/homepage-2025/hero/videos/sept-2026/wellness-desktop-poster-1500w.webp",
    },
  },
  {
