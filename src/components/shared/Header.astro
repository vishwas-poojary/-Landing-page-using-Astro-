---
import { siteConfig } from "@/lib/site-content";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 bg-transparent hero-nav-in">
  <div class="w-full px-6 sm:px-10 lg:px-14">
    <div class="flex items-center justify-between h-20 sm:h-24">
      <!-- Logo: Iconic Emblem + SQUARESPACE text -->
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center gap-3 text-white focus:outline-none group" aria-label="Squarespace Home">
          <svg class="h-6 w-auto text-white transition-transform duration-200 group-hover:scale-105" viewBox="0 0 38 30" fill="currentColor">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M21.5542 6.19939L23.3865 8.02863L23.3835 8.03156L11.6382 19.7716C10.3536 21.0568 8.63974 21.7655 6.81638 21.7655C4.99302 21.7655 3.27918 21.0568 1.99454 19.7716C-0.663544 17.113 -0.663544 12.7899 1.99454 10.1314L12.1296 0L13.9618 1.82923L3.82678 11.9606C2.17806 13.6075 2.17806 16.2896 3.82678 17.9394C5.4755 19.5893 8.16022 19.5893 9.80894 17.9394L21.5542 6.19939ZM19.4349 4.12313L7.74291 15.8808L5.92251 14.0486L17.6145 2.29096C18.8932 1.00285 20.5982 0.294098 22.4127 0.294098C24.2272 0.294098 25.9321 1.00285 27.2108 2.29096L28.1225 3.20558L26.2992 5.03775L25.3875 4.12313C24.5942 3.32321 23.5404 2.88502 22.4127 2.88502C21.2849 2.88502 20.2282 3.32321 19.4349 4.12313ZM35.0074 10.2284C33.7228 8.94325 32.0089 8.2345 30.1856 8.2345C28.3622 8.2345 26.6484 8.94325 25.3637 10.2284L13.6184 21.9684L15.4477 23.7977L27.193 12.0577C28.8417 10.4078 31.5265 10.4108 33.1752 12.0577C33.9714 12.8546 34.4125 13.9163 34.4125 15.0485C34.4125 16.1808 33.9744 17.2424 33.1752 18.0394L23.0401 28.1708L24.8724 30L35.0074 19.8687C37.6655 17.2101 37.6655 12.887 35.0074 10.2284ZM29.2606 14.1178L29.262 14.1163H29.2591L29.2606 14.1178ZM29.2606 14.1178L17.57 25.8739C15.9272 27.5238 13.2573 27.5267 11.6145 25.8739L10.7028 24.9593L8.87947 26.7915L9.79115 27.7061C11.0699 28.9942 12.7748 29.703 14.5893 29.703C16.4038 29.703 18.1088 28.9942 19.3875 27.7061L31.0795 15.9484L29.2606 14.1178Z" />
          </svg>
          <span class="text-base sm:text-lg font-bold tracking-[0.05em] uppercase font-sans">SQUARESPACE</span>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden lg:flex items-center gap-6 xl:gap-8 ml-2" aria-label="Main Navigation">
          {siteConfig.nav.map((navItem) => (
            <div class="relative group">
              <button 
                class="flex items-center gap-1 text-[13px] font-bold uppercase tracking-[0.08em] text-white hover:text-neutral-300 transition-colors py-2 focus:outline-none cursor-pointer"
                aria-expanded="false"
              >
                <span>{navItem.title}</span>
                <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M3.5 5.5L8 10L12.5 5.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
              </button>

              <!-- Mega Dropdown -->
              <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 transition-all duration-200 ease-out absolute left-0 top-full pt-2 z-50 w-screen max-w-[880px] pointer-events-none group-hover:pointer-events-auto">
                <div class="bg-neutral-950/95 backdrop-blur-2xl border border-white/15 rounded-2xl shadow-2xl p-6 overflow-hidden">
                  <div class="grid grid-cols-3 gap-6">
                    {navItem.groups?.map((group) => (
                      <div class="space-y-4">
                        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-400 border-b border-white/10 pb-2">
                          {group.label}
                        </h4>
                        <ul class="space-y-2.5">
                          {group.items.map((item) => (
                            <li>
                              <a href={item.href} class="block group/link p-2 -mx-2 rounded-lg hover:bg-white/5 transition-all">
                                <div class="text-sm font-semibold text-white group-hover/link:text-neutral-200 flex items-center justify-between">
                                  <span>{item.title}</span>
                                  <span class="opacity-0 group-hover/link:opacity-100 transition-opacity text-xs text-neutral-400">→</span>
                                </div>
                                {item.description && (
                                  <p class="text-xs text-neutral-400 mt-0.5 line-clamp-1 font-normal">{item.description}</p>
                                )}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>

                  {navItem.featured && (
                    <div class="mt-6 pt-5 border-t border-white/10 flex items-center justify-between bg-white/[0.03] -mx-6 -mb-6 p-6 rounded-b-2xl">
                      <div>
                        <span class="text-xs font-semibold text-neutral-400 uppercase tracking-wider">Spotlight</span>
                        <h5 class="text-sm font-semibold text-white mt-0.5">{navItem.featured.title}</h5>
                        <p class="text-xs text-neutral-400 mt-0.5">{navItem.featured.description}</p>
                      </div>
                      <a href={navItem.featured.href} class="text-xs font-bold uppercase tracking-wider text-black bg-white hover:bg-neutral-200 px-4 py-2 rounded-[3px] transition-colors">
                        {navItem.featured.linkText} →
                      </a>
                    </div>
                  )}
                </div>
              </div>
            </div>
          ))}
        </nav>
      </div>

      <!-- Right CTAs -->
      <div class="flex items-center gap-6 sm:gap-8">
        <a href="#templates" class="text-[13px] font-bold uppercase tracking-[0.08em] text-white hover:text-neutral-300 transition-colors">
          LOG IN
        </a>
        <a href="#templates" class="inline-flex items-center justify-center bg-white text-black hover:bg-neutral-100 font-bold uppercase tracking-[0.06em] text-[13px] px-6 sm:px-7 py-3 rounded-[3px] transition-all duration-200 shadow-md hover:scale-[1.02]">
          GET STARTED
        </a>

        <!-- Mobile hamburger toggle -->
        <button id="mobile-menu-toggle" class="lg:hidden p-2 text-white hover:text-neutral-300 focus:outline-none" aria-label="Toggle Navigation">
          <svg class="w-6 h-6 menu-open-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg class="w-6 h-6 menu-close-icon hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="lg:hidden fixed inset-x-0 top-20 bottom-0 bg-black/95 backdrop-blur-2xl border-t border-white/10 p-6 overflow-y-auto hidden flex-col justify-between">
    <div class="space-y-6">
      {siteConfig.nav.map((navItem) => (
        <div class="border-b border-white/10 pb-4">
          <div class="text-sm font-bold uppercase tracking-wider text-white mb-3">{navItem.title}</div>
          <div class="grid grid-cols-1 gap-2 pl-2">
            {navItem.groups?.flatMap(g => g.items).slice(0, 5).map((item) => (
              <a href={item.href} class="mobile-nav-link text-sm text-neutral-400 hover:text-white py-1.5 flex items-center justify-between">
                <span>{item.title}</span>
                <span class="text-xs text-neutral-600">→</span>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="pt-6 border-t border-white/10 space-y-3">
      <a href="#templates" class="w-full block text-center bg-white text-black font-bold uppercase tracking-wider text-sm py-3.5 rounded-[3px] mobile-nav-link">
        GET STARTED
      </a>
      <a href="#templates" class="w-full block text-center border border-white/20 text-white font-bold uppercase tracking-wider text-sm py-3.5 rounded-[3px] mobile-nav-link">
        LOG IN
      </a>
    </div>
  </div>
</header>

<script>
  function setupHeader() {
    const header = document.getElementById("site-header");
    const toggle = document.getElementById("mobile-menu-toggle");
    const drawer = document.getElementById("mobile-drawer");
    const openIcon = toggle?.querySelector(".menu-open-icon");
    const closeIcon = toggle?.querySelector(".menu-close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    // Dynamic header styling on scroll
    window.addEventListener("scroll", () => {
      if (window.scrollY > 40) {
        header?.classList.remove("bg-transparent");
        header?.classList.add("bg-black/85", "backdrop-blur-md", "border-b", "border-white/10");
      } else {
        header?.classList.remove("bg-black/85", "backdrop-blur-md", "border-b", "border-white/10");
        header?.classList.add("bg-transparent");
      }
    });

    // Mobile menu toggle
    toggle?.addEventListener("click", () => {
      const isHidden = drawer?.classList.contains("hidden");
      if (isHidden) {
        drawer?.classList.remove("hidden");
        drawer?.classList.add("flex");
        openIcon?.classList.add("hidden");
        closeIcon?.classList.remove("hidden");
        document.body.style.overflow = "hidden";
      } else {
        drawer?.classList.add("hidden");
        drawer?.classList.remove("flex");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        drawer?.classList.add("hidden");
        drawer?.classList.remove("flex");
        openIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
        document.body.style.overflow = "";
      });
    });
  }

  setupHeader();
  document.addEventListener("astro:page-load", setupHeader);
</script>
